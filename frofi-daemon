# --- raw X bindings ----------------------------------------------------------
# super-remap turns the physical left Super (keycode 133) into the F13 keysym,
# so it isn't a modifier and Gdk never sets MOD4 when it's held. The daemon
# uses libX11 directly for two jobs that Gdk doesn't expose cleanly:
#   - XQueryKeymap to read whether keycode 133 is currently held when the
#     popup opens (bootstraps the super_held flag for the first chord).
#   - XGrabKey + XNextEvent in a background thread to own the F13 launch
#     binding ourselves; mutter's custom-keybinding flow holds an active
#     keyboard grab from press until release, which blocks the popup's own
#     seat grab while Super is still down. Owning the grab lets us use
#     GrabModeAsync so events flow freely.
_xlib = ctypes.CDLL(ctypes.util.find_library('X11'))
_xlib.XOpenDisplay.restype = ctypes.c_void_p
_xlib.XOpenDisplay.argtypes = [ctypes.c_char_p]
_xlib.XQueryKeymap.restype = None
_xlib.XQueryKeymap.argtypes = [ctypes.c_void_p, ctypes.c_char * 32]
_xlib.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
_xlib.XDefaultRootWindow.restype = ctypes.c_ulong
_xlib.XGrabKey.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_uint,
                           ctypes.c_ulong, ctypes.c_int,
                           ctypes.c_int, ctypes.c_int]
_xlib.XGrabKey.restype = ctypes.c_int
_xlib.XUngrabKeyboard.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
_xlib.XUngrabKeyboard.restype = ctypes.c_int
_xlib.XSync.argtypes = [ctypes.c_void_p, ctypes.c_int]
_xlib.XSync.restype = ctypes.c_int
_xlib.XNextEvent.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
_xlib.XNextEvent.restype = ctypes.c_int
_xlib.XkbSetDetectableAutoRepeat.argtypes = [
    ctypes.c_void_p, ctypes.c_int, ctypes.POINTER(ctypes.c_int)]
_xlib.XkbSetDetectableAutoRepeat.restype = ctypes.c_int
_xlib.XkbKeycodeToKeysym.argtypes = [ctypes.c_void_p, ctypes.c_ubyte,
                                      ctypes.c_int, ctypes.c_int]
_xlib.XkbKeycodeToKeysym.restype = ctypes.c_ulong
_xlib.XGetErrorText.argtypes = [ctypes.c_void_p, ctypes.c_int,
                                 ctypes.c_char_p, ctypes.c_int]
_xlib.XGetErrorText.restype = ctypes.c_int
_xlib.XSetErrorHandler.argtypes = [ctypes.c_void_p]
_xlib.XSetErrorHandler.restype = ctypes.c_void_p

LEFT_SUPER_KEYCODE = 133            # the physical Super key that emits F13
_F13_KEYSYM = 0xffca


class _XErrorEvent(ctypes.Structure):
    _fields_ = [
        ('type', ctypes.c_int),
        ('display', ctypes.c_void_p),
        ('resourceid', ctypes.c_ulong),
        ('serial', ctypes.c_ulong),
        ('error_code', ctypes.c_ubyte),
        ('request_code', ctypes.c_ubyte),
        ('minor_code', ctypes.c_ubyte),
    ]


@ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.POINTER(_XErrorEvent))
def _x_error_handler(display, errev):
    # Xlib's default handler exits the process on errors. Replace it with one
    # that logs to stderr so a refused XGrabKey (e.g. someone else holds the
    # passive grab on F13) is visible instead of silent. Gdk's per-call error
    # traps still win because they install their own handler around their
    # requests via XSetErrorHandler and restore on the way out.
    err = errev.contents
    buf = ctypes.create_string_buffer(256)
    _xlib.XGetErrorText(display, err.error_code, buf, 256)
    print(f"frofi-daemon: X error ({buf.value.decode('utf-8', 'replace')}): "
          f"request={err.request_code}.{err.minor_code} "
          f"resource={err.resourceid:#x}",
          file=sys.stderr, flush=True)
    return 0


_xlib.XSetErrorHandler(ctypes.cast(_x_error_handler, ctypes.c_void_p))


class _XKeyEvent(ctypes.Structure):
    _fields_ = [
        ('type', ctypes.c_int),
        ('serial', ctypes.c_ulong),
        ('send_event', ctypes.c_int),
        ('display', ctypes.c_void_p),
        ('window', ctypes.c_ulong),
        ('root', ctypes.c_ulong),
        ('subwindow', ctypes.c_ulong),
        ('time', ctypes.c_ulong),
        ('x', ctypes.c_int),
        ('y', ctypes.c_int),
        ('x_root', ctypes.c_int),
        ('y_root', ctypes.c_int),
        ('state', ctypes.c_uint),
        ('keycode', ctypes.c_uint),
        ('same_screen', ctypes.c_int),
    ]


class _XEvent(ctypes.Union):
    # XEvent's union is 192 bytes on 64-bit; pad to that so XNextEvent never
    # writes past the end whatever event type arrives.
    _fields_ = [('type', ctypes.c_int),
                ('xkey', _XKeyEvent),
                ('_pad', ctypes.c_long * 24)]


_KEY_PRESS = 2
_KEY_RELEASE = 3
_GRAB_MODE_ASYNC = 1
# XGrabKey matches the modifier state exactly, so a separate grab is needed
# for each combination of Lock-class modifiers that can be folded into it.
_LOCK_MASK = 1 << 1                 # CapsLock
_MOD2_MASK = 1 << 4                 # NumLock
_LOCK_COMBOS = (0, _LOCK_MASK, _MOD2_MASK, _LOCK_MASK | _MOD2_MASK)


def keycode_held(xdisplay, kc):
    if not xdisplay:
        return False
    keys = (ctypes.c_char * 32)()
    _xlib.XQueryKeymap(xdisplay, keys)
    return bool(keys[kc // 8][0] & (1 << (kc % 8)))


def wait_for_super_remap(xdisplay, timeout=5.0):
    """Block until keycode 133 emits F13, i.e. super-remap has finished.

    Both super-remap and frofi-daemon are XDG autostart entries with no
    declared ordering. If frofi grabs the keycode while Super_L is still in
    mod4 (super-remap not yet done), a quick Super+arrow chord can leak to
    mutter's <Super>Up=maximize passive grab on the background window before
    the popup's seat grab lands. Waiting on the remap closes that window.
    """
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if _xlib.XkbKeycodeToKeysym(xdisplay, LEFT_SUPER_KEYCODE,
                                     0, 0) == _F13_KEYSYM:
            return True
        time.sleep(0.05)
    return False


def f13_grab_loop(on_press):
    """Passively grab the left-Super keycode in a dedicated X connection;
    post `on_press` to the GTK main loop on each fresh KeyPress.

    XGrabKey establishes an active grab on this connection whenever the key
    fires. Releasing it immediately (XUngrabKeyboard) lets the popup's own
    seat grab — on Gdk's separate X connection — claim the keyboard while
    Super is still held. Auto-repeat may briefly re-trigger the passive grab
    between ungrab and seat-grab, but on_press is idempotent so duplicate
    schedules are harmless.
    """
    dpy = _xlib.XOpenDisplay(None)
    if not dpy:
        print("frofi-daemon: F13 grab cannot open display",
              file=sys.stderr, flush=True)
        return
    supported = ctypes.c_int(0)
    _xlib.XkbSetDetectableAutoRepeat(dpy, 1, ctypes.byref(supported))
    root = _xlib.XDefaultRootWindow(dpy)
    for mods in _LOCK_COMBOS:
        _xlib.XGrabKey(dpy, LEFT_SUPER_KEYCODE, mods, root, 1,
                       _GRAB_MODE_ASYNC, _GRAB_MODE_ASYNC)
    _xlib.XSync(dpy, 0)
    ev = _XEvent()
    while True:
        _xlib.XNextEvent(dpy, ctypes.byref(ev))
        if ev.type == _KEY_PRESS and ev.xkey.keycode == LEFT_SUPER_KEYCODE:
            _xlib.XUngrabKeyboard(dpy, 0)   # CurrentTime
            _xlib.XSync(dpy, 0)
            GLib.idle_add(on_press)


# --- rectangle coverage ------------------------------------------------------
# Classify each window as fully visible / partially covered / fully hidden by
# subtracting every higher-stacked window's rect from the candidate's own
# rect. Whatever remains is the uncovered area; nothing remaining = hidden,
# unmodified = full, anything else = partial.
def _rect_intersect(a, b):
    ax, ay, aw, ah = a
    bx, by, bw, bh = b
    x1, y1 = max(ax, bx), max(ay, by)
    x2, y2 = min(ax + aw, bx + bw), min(ay + ah, by + bh)
    if x2 <= x1 or y2 <= y1:
        return None
    return (x1, y1, x2 - x1, y2 - y1)


def _rect_subtract(piece, hole):
    # Returns up-to-4 axis-aligned remainders of `piece` outside `hole`,
    # assuming `hole` is the intersection of `piece` with another rect (so
    # it lies entirely within `piece`).
    px, py, pw, ph = piece
    hx, hy, hw, hh = hole
    out = []
    if hy > py:
        out.append((px, py, pw, hy - py))
    if hy + hh < py + ph:
        out.append((px, hy + hh, pw, (py + ph) - (hy + hh)))
    if hx > px:
        out.append((px, hy, hx - px, hh))
    if hx + hw < px + pw:
        out.append((hx + hw, hy, (px + pw) - (hx + hw), hh))
    return out


def _classify_visibility(candidate, higher):
    cw, ch = candidate[2], candidate[3]
    if cw <= 0 or ch <= 0:
        return "hidden"
    remaining = [candidate]
    touched = False
    for h in higher:
        nxt = []
        for piece in remaining:
            inter = _rect_intersect(piece, h)
            if inter is None:
                nxt.append(piece)
            else:
                touched = True
                nxt.extend(_rect_subtract(piece, inter))
        remaining = nxt
        if not remaining:
            return "hidden"
    return "full" if not touched else "partial"


