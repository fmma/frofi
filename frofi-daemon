# Layout-mode glyphs: floating window, maximized, left half, right half.
# The floating glyph is an outlined square with an inner block (rather than a
# plain outline) so it stays distinct from the solid maximized square when a
# selected row inverts the colors; fill polarity alone would read ambiguously.
MODE_GLYPHS = {"window": "▣", "max": "■", "left": "◧", "right": "◨"}


# --- client ------------------------------------------------------------------
# The client just sends one line over the socket. It runs on every Super+Tab,
# so it must stay lightweight: handle it here, before importing gi/GTK/Wnck
# (that import alone costs ~150 ms of process startup).
def run_client(args):
    cmd = " ".join(args) if args else "show"
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(SOCK_PATH)
    except OSError:
        sys.exit(1)          # daemon not running; wrapper handles startup
    s.sendall((cmd + "\n").encode())
    s.close()


if len(sys.argv) > 1 and sys.argv[1] == "--client":
    run_client(sys.argv[2:])
    sys.exit(0)


