_F13_KEYSYM = 0xffca


class _XErrorEvent(ctypes.Structure):
    _fields_ = [
        ('type', ctypes.c_int),
        ('display', ctypes.c_void_p),
        ('resourceid', ctypes.c_ulong),
        ('serial', ctypes.c_ulong),
        ('error_code', ctypes.c_ubyte),
        ('request_code', ctypes.c_ubyte),
        ('minor_code', ctypes.c_ubyte),
    ]


@ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_void_p, ctypes.POINTER(_XErrorEvent))
def _x_error_handler(display, errev):
    # Xlib's default handler exits the process on errors. Replace it with one
    # that logs to stderr so a refused XGrabKey (e.g. someone else holds the
    # passive grab on F13) is visible instead of silent. Gdk's per-call error
    # traps still win because they install their own handler around their
    # requests via XSetErrorHandler and restore on the way out.
    err = errev.contents
    buf = ctypes.create_string_buffer(256)
    _xlib.XGetErrorText(display, err.error_code, buf, 256)
    print(f"frofi-daemon: X error ({buf.value.decode('utf-8', 'replace')}): "
          f"request={err.request_code}.{err.minor_code} "
          f"resource={err.resourceid:#x}",
          file=sys.stderr, flush=True)
    return 0


_xlib.XSetErrorHandler(ctypes.cast(_x_error_handler, ctypes.c_void_p))


