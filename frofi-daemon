    # --- live X queries (Wnck, no subprocess) --------------------------------
    def current_ws(self):
        ws = self.screen.get_active_workspace()
        return ws.get_number() if ws is not None else 0

    def num_ws(self):
        return max(1, self.screen.get_workspace_count())

    def active_xid(self):
        w = self.screen.get_active_window()
        return w.get_xid() if w is not None else None

    def active_wid_str(self):
        """Wid string of the row that represents the currently-focused
        thing. For a focused wezterm window it's "tm:<session>" of the
        session attached to that wezterm; for everything else it's the X11
        wid hex. Returns "" when nothing useful is focused.
        """
        active = self.active_xid()
        if active is None:
            return ""
        host = self._wezterm_hosts().for_xid(active)
        if host is not None:
            return TMUX_WID_PREFIX + host.session
        if CHROME_PER_TAB:
            window = self._chrome_registry().window_for_xid(active)
            if window is not None:
                active_tab = next((t for t in window.tabs if t.active), None)
                if active_tab is not None:
                    return CHROME_WID_PREFIX + active_tab.target_id
        return "0x%08x" % active

    def wnck_window(self, wid):
        # Virtual-window rows (tmux session, chrome tab) aren't X11 windows;
        # tile/max/move-monitor etc. need to operate on the parent X11
        # window so the viewport gets the geometry change. The registries
        # already hold the parent's wnck.Window, so return it directly
        # instead of round-tripping through xid + screen scan.
        if is_tmux_wid(wid):
            host = self._wezterm_hosts().for_session(tmux_session_name(wid))
            return host.wnck_window if host is not None else None
        if is_chrome_wid(wid):
            tab = self._chrome_registry().tab(chrome_target_id(wid))
            if tab is None:
                return None
            parent = self._chrome_registry().window_for_cdp(tab.parent_cdp_id)
            return parent.wnck_window if parent is not None else None
        target = int(wid, 16)
        for w in self.screen.get_windows():
            if w.get_xid() == target:
                return w
        return None

    # --- wezterm CLI -----------------------------------------------------
    def _wezterm_gui_sockets(self):
        """Return [(pid, sock_path)] for every wezterm-gui process whose
        socket lives in $XDG_RUNTIME_DIR/wezterm/. Each independent
        wezterm-gui process owns its own gui-sock-<pid> file."""
        base = os.path.join(
            os.environ.get("XDG_RUNTIME_DIR",
                           f"/run/user/{os.getuid()}"),
            "wezterm")
        out = []
        try:
            for name in os.listdir(base):
                if not name.startswith("gui-sock-"):
                    continue
                try:
                    pid = int(name[len("gui-sock-"):])
                except ValueError:
                    continue
                if os.path.exists(f"/proc/{pid}"):
                    out.append((pid, os.path.join(base, name)))
        except OSError:
            pass
        return out

    def _wezterm_panes(self):
        """Aggregate wezterm CLI panes across every wezterm-gui process.

        Each pane dict carries the canonical fields (window_id, tab_id,
        pane_id, is_active, title, tab_title, tty_name) plus an added
        `gui_pid` so callers can disambiguate when multiple independent
        wezterm-gui processes coexist, or when one process hosts several
        windows. A short timeout per socket keeps a frozen process from
        stalling rebuild; result is cached 100 ms so one rebuild_ws sweep
        makes one subprocess invocation per gui.
        """
        now = time.monotonic()
        cached = getattr(self, "_panes_cache", None)
        if cached is not None and now - cached[0] < 0.1:
            return cached[1]
        out = []
        for pid, sock in self._wezterm_gui_sockets():
            try:
                env = os.environ.copy()
                env["WEZTERM_UNIX_SOCKET"] = sock
                # --no-auto-start: don't spawn a wezterm-mux-server for
                # a socket whose gui process died mid-rebuild.
                r = subprocess.run(["wezterm", "cli", "--no-auto-start",
                                    "list", "--format", "json"],
                                   env=env, capture_output=True, text=True,
                                   timeout=1.5, check=True)
                data = json.loads(r.stdout)
                if isinstance(data, list):
                    for pane in data:
                        pane["gui_pid"] = pid
                        out.append(pane)
            except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
                pass
        self._panes_cache = (now, out)
        return out

    def _wezterm_hosts(self):
        """Snapshot of every wezterm window hosting a tmux client. The
        underlying data (panes, tmux clients) is already cached for
        ~100ms, so repeated calls within one rebuild are cheap."""
        return WeztermHostRegistry.build(
            self.screen, self._tmux_clients(), self._wezterm_panes())

    # --- tmux CLI --------------------------------------------------------
    def _tmux(self, *args, capture=False):
        """Run a tmux command with a tight timeout. Returns stdout when
        `capture` is set, else None. All errors are swallowed: a missing or
        stuck tmux must not block rebuild."""
        try:
            r = subprocess.run(["tmux", *args],
                               capture_output=capture, text=True,
                               timeout=1.0, check=True)
        except (OSError, subprocess.SubprocessError):
            return "" if capture else None
        return r.stdout if capture else None

    def _tmux_sessions(self):
        """List sessions: [{name, attached, title}].

        title mirrors the SSH-aware logic the wezterm.lua had: a remote
        host shows as "<host> <remote_path>" parsed from pane_title (which
        the remote shell maintains via OSC); otherwise the local
        pane_current_path with $HOME collapsed to ~. Cached for 100 ms so
        a rebuild_ws sweep makes one tmux call.
        """
        now = time.monotonic()
        cached = getattr(self, "_tmux_cache", None)
        if cached is not None and now - cached[0] < 0.1:
            return cached[1]
        raw = self._tmux("list-panes", "-a", "-F",
                         "#{session_name}\t#{?session_attached,1,0}\t"
                         "#{window_active}\t#{pane_active}\t"
                         "#{pane_current_command}\t#{pane_current_path}\t"
                         "#{pane_title}\t#{session_path}\t"
                         "#{pane_tty}",
                         capture=True) or ""
        out = []
        seen = set()
        for line in raw.splitlines():
            parts = line.split("\t")
            if len(parts) < 9:
                continue
            (name, attached, win_active, pane_active,
             cmd, cwd, ptitle, spath, pane_tty) = parts
            if win_active != "1" or pane_active != "1":
                continue
            if name in seen:
                continue
            seen.add(name)
            out.append({"name": name,
                        "attached": attached == "1",
                        "title": self._compose_session_title(
                            cmd, cwd, ptitle, spath, pane_tty)})
        self._tmux_cache = (now, out)
        return out

    @staticmethod
    def _compose_session_title(cmd, cwd, ptitle, spath, pane_tty=None):
        # SSH branch: prefer the remote shell's OSC-set "user@host:path"
        # pane_title; if absent (default bash, etc.), pull the host from
        # the running ssh process's argv on pane_tty. Falls through to the
        # local-path branch if both fail.
        if cmd == "ssh":
            m = re.search(r"@([\w._-]+):\s*(\S+)", ptitle or "")
            if m:
                return f"{m.group(1).split('.')[0]} {m.group(2)}"
            m = re.search(r"@([\w._-]+)", ptitle or "")
            if m:
                return m.group(1).split('.')[0]
            host = Switcher._ssh_host_from_tty(pane_tty) if pane_tty else None
            if host:
                return host.split('.')[0]
            # fall through
        path = cwd or spath or ""
        home = os.path.expanduser("~")
        # Sole $HOME stays absolute so it's distinguishable from a session
        # with no path info; only subfolders collapse to ~/.
        if path.startswith(home + "/"):
            return "~" + path[len(home):]
        return path

    # ssh argv parsing: skip the flags that take a value, then return the
    # first positional with @user@ stripped. Mirrors the lua's "@host" parse
    # for cases where the remote shell doesn't maintain pane_title.
    _SSH_TAKES_ARG = frozenset({
        "-p", "-i", "-l", "-o", "-J", "-L", "-R", "-W", "-D",
        "-F", "-S", "-E", "-Q", "-O", "-c", "-m", "-b", "-B"})

    @staticmethod
    def _parse_ssh_host(argv):
        it = iter(argv[1:])     # argv[0] is "ssh"
        for tok in it:
            if tok.startswith("-"):
                if tok in Switcher._SSH_TAKES_ARG:
                    next(it, None)
                continue            # plain short flag, no value to skip
            return tok.split("@", 1)[1] if "@" in tok else tok
        return None

    @staticmethod
    def _ssh_host_from_tty(pane_tty):
        # Scan ps output for the foreground ssh on this tty. The '+'
        # in stat marks the foreground process group; that's the ssh the
        # user is actually talking to (vs. a backgrounded subshell ssh).
        if not pane_tty or not pane_tty.startswith("/dev/"):
            return None
        try:
            r = subprocess.run(
                ["ps", "-t", pane_tty[len("/dev/"):],
                 "-o", "stat=,args="],
                capture_output=True, text=True,
                timeout=0.3, check=False)
        except (OSError, subprocess.SubprocessError):
            return None
        candidates = []
        for line in r.stdout.splitlines():
            line = line.strip()
            if not line:
                continue
            stat, _, args = line.partition(" ")
            argv = args.split()
            if not argv or os.path.basename(argv[0]) != "ssh":
                continue
            candidates.append((0 if "+" in stat else 1, argv))
        if not candidates:
            return None
        candidates.sort(key=lambda c: c[0])     # foreground first
        return Switcher._parse_ssh_host(candidates[0][1])

    def _tmux_clients(self):
        """{client_tty -> session_name} for every attached tmux client.
        Cached 100 ms so a rebuild sweep makes one tmux call instead of
        one per workspace (each WeztermHostRegistry.build consumes it)."""
        now = time.monotonic()
        cached = getattr(self, "_tmux_clients_cache", None)
        if cached is not None and now - cached[0] < 0.1:
            return cached[1]
        raw = self._tmux("list-clients", "-F",
                         "#{client_tty}\t#{client_session}",
                         capture=True) or ""
        out = {}
        for line in raw.splitlines():
            parts = line.split("\t", 1)
            if len(parts) == 2 and parts[0]:
                out[parts[0]] = parts[1]
        self._tmux_clients_cache = (now, out)
        return out


    # --- chrome native-host client ---------------------------------------
    def _chrome_call(self, req, timeout=0.3):
        """One-shot unix-socket RPC to chrome-frofi-host. Returns parsed
        JSON reply or None on any failure (host not running, extension
        unloaded, chrome closed)."""
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(timeout)
            s.connect(CHROME_HOST_SOCK)
            s.sendall((json.dumps(req) + "\n").encode("utf-8"))
            buf = b""
            while b"\n" not in buf and len(buf) < 1 << 20:
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
            s.close()
            line = buf.split(b"\n", 1)[0]
            return json.loads(line.decode("utf-8")) if line else None
        except (OSError, json.JSONDecodeError):
            return None

    def _chrome_snapshot(self):
        """Native host's latest tab+window snapshot, or {tabs:[],windows:[]}
        on any failure. Cached 100 ms so a rebuild_ws sweep makes one trip.
        """
        now = time.monotonic()
        cached = getattr(self, "_chrome_cache", None)
        if cached is not None and now - cached[0] < 0.1:
            return cached[1]
        snap = self._chrome_call({"action": "snapshot"})
        if not isinstance(snap, dict):
            snap = {"tabs": [], "windows": []}
        self._chrome_cache = (now, snap)
        return snap

    def _chrome_registry(self):
        """Refresh the chrome registry against the current snapshot and
        focused-window state, then return it. Cheap: the underlying
        snapshot is 100ms-cached, and the resolution pass is O(windows
        x cdp_ids), which is tiny in practice."""
        self.chrome_registry.rebuild(
            self.screen, self._chrome_snapshot(), self.active_xid())
        return self.chrome_registry

    def server_time(self):
        # A current X server timestamp keeps mutter's focus-stealing
        # prevention from rejecting activate/close. One round-trip, sub-ms.
        win = self.get_window()
        if win is not None:
            try:
                return GdkX11.x11_get_server_time(win)
            except Exception:
                pass
        return Gtk.get_current_event_time()

    def activate_xid(self, xid, t):
        """Raise xid via _NET_ACTIVE_WINDOW with source=2 (pager).

        Wnck.Window.activate() sends source=1 (application), which
        mutter's focus-stealing prevention rejects whenever the
        currently-focused window has a fresher _NET_WM_USER_TIME than
        the timestamp we pass -- exactly what chrome triggers when a
        background tab updates its user-time (e.g. cijoe opening a
        results tab). source=2 is documented for pagers/taskbars and
        bypasses the check; frofi is one.
        """
        if not self._xdpy or not xid:
            return
        atom = _xlib.XInternAtom(self._xdpy,
                                  b"_NET_ACTIVE_WINDOW", 0)
        ev = _XEvent()
        ev.xclient.type = _CLIENT_MESSAGE
        ev.xclient.send_event = 1
        ev.xclient.display = self._xdpy
        ev.xclient.window = ctypes.c_ulong(xid).value
        ev.xclient.message_type = atom
        ev.xclient.format = 32
        ev.xclient.data.l[0] = 2          # source: pager
        ev.xclient.data.l[1] = ctypes.c_long(t).value
        ev.xclient.data.l[2] = 0
        ev.xclient.data.l[3] = 0
        ev.xclient.data.l[4] = 0
        mask = _SUBSTRUCTURE_NOTIFY_MASK | _SUBSTRUCTURE_REDIRECT_MASK
        root = _xlib.XDefaultRootWindow(self._xdpy)
        _xlib.XSendEvent(self._xdpy, root, 0, mask, ctypes.byref(ev))
        _xlib.XSync(self._xdpy, 0)

    def activate_wnck(self, w, t):
        """Activate a Wnck.Window via _NET_ACTIVE_WINDOW source=2."""
        if w is None:
            return
        self.activate_xid(w.get_xid(), t)

    # --- icons ---------------------------------------------------------------
    def icon_image(self, name):
        if not name:
            img = Gtk.Image()
            img.set_size_request(ICON_SIZE, ICON_SIZE)   # keep row heights equal
            return img
        if name in self._icon_cache:
            pb = self._icon_cache[name]
        else:
            pb = self._load_icon(name)
            self._icon_cache[name] = pb
        img = Gtk.Image.new_from_pixbuf(pb) if pb else Gtk.Image()
        img.set_size_request(ICON_SIZE, ICON_SIZE)
        return img

    def _load_icon(self, name):
        try:
            if os.path.isabs(name) and os.path.exists(name):
                return GdkPixbuf.Pixbuf.new_from_file_at_size(name, ICON_SIZE, ICON_SIZE)
            theme = Gtk.IconTheme.get_default()
            if theme.has_icon(name):
                return theme.load_icon(name, ICON_SIZE, Gtk.IconLookupFlags.FORCE_SIZE)
            for ext in ("png", "svg", "xpm"):
                p = f"/usr/share/pixmaps/{name}.{ext}"
                if os.path.exists(p):
                    return GdkPixbuf.Pixbuf.new_from_file_at_size(p, ICON_SIZE, ICON_SIZE)
        except Exception:
            pass
        return None

    def mode_icon(self, key, vis="full"):
        """Gtk.Image of the layout-mode indicator, or a blank spacer for ''.

        The blank keeps the column width constant so app icons stay aligned in
        modes (drun, help) that have no indicator.
        """
        if not key:
            img = Gtk.Image()
            img.set_size_request(MODE_ICON_SIZE, MODE_ICON_SIZE)
            return img
        cache_key = (key, vis)
        pb = self._mode_icons.get(cache_key)
        if pb is None:
            pb = self._render_mode_icon(key, vis)
            self._mode_icons[cache_key] = pb
        img = Gtk.Image.new_from_pixbuf(pb)
        img.set_size_request(MODE_ICON_SIZE, MODE_ICON_SIZE)
        return img

    def _render_mode_icon(self, key, vis):
        # A dark "screen" tile with the occupied region filled. Fill brightness
        # reflects visibility (full/partial/hidden); the shape is the same in
        # every state so the tile read survives even for hidden windows.
        s = MODE_ICON_SIZE
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, s, s)
        cr = cairo.Context(surf)
        cr.set_source_rgb(*MODE_ICON_TILE)
        cr.rectangle(0, 0, s, s)
        cr.fill()
        m = 3                       # margin between tile edge and occupied area
        iw = s - 2 * m
        fill = (MODE_ICON_FILL_HIDDEN if vis == "hidden"
                else MODE_ICON_FILL_VISIBLE)
        cr.set_source_rgb(*fill)
        if key == "max":
            cr.rectangle(m, m, iw, iw)
        elif key == "left":
            cr.rectangle(m, m, iw / 2 - 0.5, iw)
        elif key == "right":
            cr.rectangle(m + iw / 2 + 0.5, m, iw / 2 - 0.5, iw)
        else:                       # "window": a small centered floating block
            bw = iw * 0.55
            cr.rectangle((s - bw) / 2, (s - bw) / 2, bw, bw)
        cr.fill()
        surf.flush()
        return Gdk.pixbuf_get_from_surface(surf, 0, 0, s, s)

    # --- row construction ----------------------------------------------------
    def add_row(self, slot_text, mode_key, mode_digit, icon_name, markup,
                search, selectable=True, mode_vis="full", **data):
        row = Gtk.ListBoxRow()
        row.search_text = search.lower()
        if not selectable:                  # empty slot placeholder; skip on nav
            row.set_selectable(False)
            row.set_activatable(False)
        for k, v in data.items():
            setattr(row, k, v)
        rb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=5)
        rb.set_margin_top(2); rb.set_margin_bottom(2)
        rb.set_margin_start(12); rb.set_margin_end(12)
        slot = Gtk.Label(label=slot_text, xalign=0.0)
        slot.set_width_chars(3)
        slot.get_style_context().add_class("slot")
        rb.pack_start(slot, False, False, 0)
        # Layout-mode indicator image followed by the monitor digit (e.g. ◧ "2").
        modebox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2)
        modebox.set_valign(Gtk.Align.CENTER)
        modebox.pack_start(self.mode_icon(mode_key, mode_vis), False, False, 0)
        digit = Gtk.Label(label=mode_digit, xalign=0.0)
        digit.set_width_chars(1)            # optional monitor number
        digit.get_style_context().add_class("mode")
        modebox.pack_start(digit, False, False, 0)
        rb.pack_start(modebox, False, False, 0)
        rb.pack_start(self.icon_image(icon_name), False, False, 0)
        lbl = Gtk.Label(xalign=0.0)
        lbl.set_markup(markup)
        lbl.set_ellipsize(3)
        rb.pack_start(lbl, True, True, 0)
        row.add(rb)
        self.listbox.add(row)
        return row

    def add_separator(self, label, ws_group=None):
        # Non-selectable labeled rule between workspace groups in ws mode.
        # Shown only while its group has a visible window (see _filter).
        row = Gtk.ListBoxRow()
        row.search_text = ""
        row.is_divider = True
        row.ws_group = ws_group
        row.set_selectable(False)
        row.set_activatable(False)
        row.get_style_context().add_class("wsdivider")
        rb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        rb.set_margin_top(2); rb.set_margin_bottom(2)
        rb.set_margin_start(12); rb.set_margin_end(12)
        left = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        left.set_valign(Gtk.Align.CENTER)
        lbl = Gtk.Label(label=label, xalign=0.5)
        lbl.get_style_context().add_class("wslabel")
        right = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        right.set_valign(Gtk.Align.CENTER)
        rb.pack_start(left, True, True, 0)
        rb.pack_start(lbl, False, False, 0)
        rb.pack_start(right, True, True, 0)
        row.add(rb)
        self.listbox.add(row)
        return row

    def clear_rows(self):
        for child in self.listbox.get_children():
            self.listbox.remove(child)

    # --- window list ---------------------------------------------------------
    def list_windows(self, ws):
        """Return (ordered current-ws rows, all live wids).

        Reads the live Wnck window list (kept current via X events) plus
        short tmux CLI calls. Each workspace gets at most one host wezterm
        window; that host's row is hidden in favour of one row per tmux
        session named "ws<N>-<id>" (its session pool). Rows are (wid,
        instance, title, geometry, vmax, hmax, vis); wid is "0x..." for
        plain X11 windows and "tm:<session>" for virtual windows.
        """
        # Find this workspace's host wezterm windows (if any) via the
        # registry. Only sessions named ws<ws>- count as part of this
        # workspace's pool; hosts attached to another workspace's pool
        # are ignored. The "primary" host is the first in iteration
        # order; its geometry is the fallback for detached session rows
        # that have no live host of their own.
        ws_prefix = f"ws{ws}-"
        primary_geo = None
        primary_vmax = primary_hmax = False
        wez_parent_xids = set()
        for h in self._wezterm_hosts().on_workspace(ws):
            if not h.session.startswith(ws_prefix):
                continue
            wez_parent_xids.add(h.xid)
            if primary_geo is None:
                primary_geo = h.wnck_window.get_geometry()
                primary_vmax = h.wnck_window.is_maximized_vertically()
                primary_hmax = h.wnck_window.is_maximized_horizontally()

        # Chrome tab discovery: the registry resolves each X11 chrome
        # window to a CDP windowId and groups tabs under it. In per-tab
        # mode the X11 row is suppressed via chrome_parent_xids and one
        # row per tab is emitted below; in the default per-window mode
        # the registry is skipped entirely and chromes flow through the
        # plain X11 path.
        if CHROME_PER_TAB:
            chrome_windows = self._chrome_registry().windows_on_workspace(ws)
            chrome_parent_xids = {cw.xid for cw in chrome_windows}
        else:
            chrome_windows = []
            chrome_parent_xids = set()

        # Bottom-to-top stack on this workspace, used both for the regular
        # vis map and to compute each host wezterm/chrome parent's
        # visibility (which gates whether their attached rows read visible).
        # Per-host visibility maps let each session/tab row reflect the
        # state of its OWN parent, not the workspace's primary host
        # (which matters after detach when multiple hosts share a ws).
        stacked = []
        for w in self.screen.get_windows_stacked():
            if w.is_skip_tasklist() or w.is_minimized():
                continue
            wsobj = w.get_workspace()
            if wsobj is None or wsobj.get_number() != ws:
                continue
            stacked.append((w.get_xid(), wid_str(w), w.get_geometry()))
        vis_map = {}
        wez_parent_vis = {}
        chrome_parent_vis = {}
        for i, (xid, wid, geo) in enumerate(stacked):
            higher = [g for _x, _w, g in stacked[i+1:]]
            v = _classify_visibility(geo, higher)
            vis_map[wid] = v
            if xid in wez_parent_xids:
                wez_parent_vis[xid] = v
            if xid in chrome_parent_xids:
                chrome_parent_vis[xid] = v

        rows, all_ids = [], []
        for w in self.screen.get_windows():
            if w.is_skip_tasklist():
                continue
            title = w.get_name() or ""
            if title == OWN_TITLE:
                continue
            if w.get_xid() in wez_parent_xids:
                continue                # sessions stand in for the host
            if w.get_xid() in chrome_parent_xids:
                continue                # tab rows stand in for the host
            wid = wid_str(w)
            all_ids.append(wid)
            wsobj = w.get_workspace()
            if wsobj is not None and wsobj.get_number() == ws:
                gx, gy, gw, gh = w.get_geometry()
                inst = (w.get_class_instance_name() or "").lower()
                # Minimized windows aren't drawn, so call them hidden even
                # though they don't appear in the stacked list above.
                vis = "hidden" if w.is_minimized() else vis_map.get(wid, "full")
                rows.append((wid, inst, title, (gx, gy, gw, gh),
                             w.is_maximized_vertically(),
                             w.is_maximized_horizontally(),
                             vis))

        # Virtual-window rows: one per tmux session whose name starts with
        # "ws<N>-". If the host wezterm is missing we still surface the
        # workspace's sessions (all dim) so they remain reachable; geometry
        # falls back to (0, 0, 0, 0) which renders the floating-window
        # indicator and disables the monitor digit.
        sessions = self._tmux_sessions()
        for sess in sessions:
            if self._ws_of_session(sess["name"]) != ws:
                continue
            wid = TMUX_WID_PREFIX + sess["name"]
            own_host = self._wezterm_hosts().for_session(sess["name"])
            if own_host is not None and own_host.workspace == ws:
                # Match geometry, tile state, and visibility to the row's
                # OWN host so per-host state stays accurate even when the
                # workspace has multiple hosts (post-detach).
                w = own_host.wnck_window
                geo = w.get_geometry()
                vmax_row = w.is_maximized_vertically()
                hmax_row = w.is_maximized_horizontally()
                own_vis = wez_parent_vis.get(own_host.xid, "full")
                row_vis = "full" if own_vis != "hidden" else "hidden"
            else:
                # Detached session: no host, fall back to the workspace's
                # primary wezterm geometry for the tile-indicator visual
                # but mark the row hidden so it doesn't read as "live".
                geo = primary_geo or (0, 0, 0, 0)
                vmax_row, hmax_row = primary_vmax, primary_hmax
                row_vis = "hidden"
            all_ids.append(wid)
            rows.append((wid, WEZTERM_INST, sess["title"], geo,
                         vmax_row, hmax_row, row_vis))

        # Chrome tab rows: one per (X11 window, CDP tab) pair. Only the
        # active tab of a visible parent reads as visible; everything else
        # is dim. The CHROME_INST search key gives the row chrome's icon
        # via the existing icon_map.
        for cwin in chrome_windows:
            gx, gy, gw, gh = cwin.wnck_window.get_geometry()
            v_h = cwin.wnck_window.is_maximized_vertically()
            h_h = cwin.wnck_window.is_maximized_horizontally()
            pvis = chrome_parent_vis.get(cwin.xid, "full")
            for tab in cwin.tabs:
                wid = CHROME_WID_PREFIX + tab.target_id
                all_ids.append(wid)
                if pvis == "hidden":
                    tab_vis = "hidden"
                else:
                    tab_vis = "full" if tab.active else "hidden"
                rows.append((wid, CHROME_INST, tab.title or tab.url,
                             (gx, gy, gw, gh), v_h, h_h, tab_vis))
        return rows, all_ids

    def window_indicator(self, geo, vmax, hmax):
        """Return (mode key, monitor digit) for a window.

        GNOME's half-tile (Super+Left/Right) maximizes vertically but not
        horizontally and pins the window to one side, so vmax-without-hmax
        plus the center's x position distinguishes the two halves. The
        monitor digit is non-empty only when more than one monitor is present.
        """
        gx, gy, gw, gh = geo
        cx, cy = gx + gw // 2, gy + gh // 2
        mi, mgeo = -1, None
        for i, g in enumerate(self._monitors):
            if g.x <= cx < g.x + g.width and g.y <= cy < g.y + g.height:
                mi, mgeo = i, g
                break
        if vmax and hmax:
            mode = "max"
        elif vmax and not hmax and mgeo is not None:
            mode = "left" if cx < mgeo.x + mgeo.width // 2 else "right"
        else:
            mode = "window"
        digit = str(mi + 1) if len(self._monitors) > 1 and mi >= 0 else ""
        return mode, digit

    # --- slots (in-memory, per workspace) ------------------------------------
    def slots_for(self, ws):
        return self.slot_map.setdefault(ws, [""] * 12)

    def refresh_slots(self, ws, ordered_ids):
        """Prune dead slots and fill empties from the live window list.

        Mutates the workspace's slot list in place. State is persisted via
        _mark_dirty, so the assignment lives across daemon restarts.
        """
        slots = self.slots_for(ws)
        cur = set(ordered_ids)
        changed = False
        for i in range(12):
            if slots[i] and slots[i] not in cur:
                slots[i] = ""
                changed = True
        in_slot = {s for s in slots if s}
        for wid in ordered_ids:
            if wid in in_slot:
                continue
            for i in range(12):
                if not slots[i]:
                    slots[i] = wid
                    in_slot.add(wid)
                    changed = True
                    break
        if changed:
            self._mark_dirty()
        return slots

    def _prep_rebuild(self):
        # Shared setup for window/workspace rebuilds: drop slot lists for
        # workspaces that no longer exist and snapshot the monitor geometry
        # the indicator uses to label half-tiles and the monitor digit.
        nws = self.num_ws()
        dead = [k for k in self.slot_map if k >= nws]
        for k in dead:
            del self.slot_map[k]
        if dead:
            self._mark_dirty()
        disp = Gdk.Display.get_default()
        self._monitors = [disp.get_monitor(i).get_geometry()
                          for i in range(disp.get_n_monitors())]

    def _prune_tags(self, all_ids):
        live = set(all_ids)
        dead = [wid for wid in self.tags if wid not in live]
        for wid in dead:
            del self.tags[wid]
        if dead:
            self._mark_dirty()

    # --- persistence --------------------------------------------------------
    # Slot assignments and tags survive daemon restarts: WIDs stay stable for
    # the life of each X11 window, so a stop/start of the daemon reattaches to
    # the same windows. Stale entries (reboots, window closes between runs)
    # get pruned naturally on the next rebuild.
    def _load_state(self):
        try:
            with open(STATE_PATH) as f:
                data = json.load(f)
        except (OSError, ValueError):
            return
        if not isinstance(data, dict):
            return
        slots = data.get("slots")
        if isinstance(slots, dict):
            for ws_str, wids in slots.items():
                try:
                    ws = int(ws_str)
                except (TypeError, ValueError):
                    continue
                if not isinstance(wids, list) or len(wids) != 12:
                    continue
                if not all(w is None or isinstance(w, str) for w in wids):
                    continue
                self.slot_map[ws] = [w or "" for w in wids]
        tags = data.get("tags")
        if isinstance(tags, dict):
            for wid, tag in tags.items():
                if isinstance(wid, str) and isinstance(tag, str):
                    self.tags[wid] = tag

    def _save_state(self):
        self._state_save_timer = None
        data = {
            "version": 1,
            "slots": {
                str(ws): [w if w else None for w in slots]
                for ws, slots in self.slot_map.items()
            },
            "tags": dict(self.tags),
        }
        try:
            os.makedirs(os.path.dirname(STATE_PATH), exist_ok=True)
            tmp = STATE_PATH + ".tmp"
            with open(tmp, "w") as f:
                json.dump(data, f, separators=(",", ":"))
            os.replace(tmp, STATE_PATH)
        except OSError:
            pass
        return False

    def _mark_dirty(self):
        if self._state_save_timer is not None:
            return
        # 500ms debounce coalesces the burst of mutations a single rebuild
        # triggers (refresh_slots, _prep_rebuild, _prune_tags) into one write.
        self._state_save_timer = GLib.timeout_add(500, self._save_state)

    def _flush_state(self):
        if self._state_save_timer is not None:
            GLib.source_remove(self._state_save_timer)
            self._state_save_timer = None
            self._save_state()

    def _emit_window(self, rec, slot_i, active_wid):
        wid, inst, title, geo, vmax, hmax, vis = rec
        if active_wid and wid == active_wid:
            self._active_geo = geo
        tag = self.tags.get(wid, "")
        markup = pango(title)
        if tag:
            markup += f"  <span color='#8ab4f8'>[{pango(tag)}]</span>"
        # Warn when a tmux session row is mirrored across multiple
        # wezterm hosts; that's a state-leak the user almost never wants
        # and reattach is the way out.
        if is_tmux_wid(wid):
            name = tmux_session_name(wid)
            mirrors = len(self._wezterm_hosts().hosts_for_session(name))
            if mirrors > 1:
                markup += (f"  <span color='#dc322f' weight='bold'>"
                           f"⚠ {mirrors}×</span>")
        slot_text = f"F{slot_i + 1}" if slot_i is not None else ""
        mode_key, digit = self.window_indicator(geo, vmax, hmax)
        search = title + " " + tag
        icon = self.icon_map.get(inst, inst)
        return self.add_row(slot_text, mode_key, digit, icon, markup, search,
                            mode_vis=vis, wid=wid)

    def _emit_group(self, win_rows, slots, keep_wid, active_wid,
                    placeholders=True, ws=None):
        # One workspace's rows: a fixed row per slot (blank placeholder when
        # empty, unless placeholders is False) followed by any unslotted
        # leftovers. Each window row is tagged with its workspace (ws) so the
        # group divider can track it. Returns the keep/active rows, or None.
        by_id = {r[0]: r for r in win_rows}
        slot_of = {wid: i for i, wid in enumerate(slots) if wid}
        keep_row = active_row = None
        for i in range(12):
            wid = slots[i]
            if wid and wid in by_id:
                r = self._emit_window(by_id[wid], i, active_wid)
                r.ws_group = ws
                if wid == keep_wid:
                    keep_row = r
                if active_wid and wid == active_wid:
                    active_row = r
            elif placeholders:
                self.add_row(f"F{i + 1}", "", "", None, "", "", selectable=False)
        for tup in win_rows:
            wid = tup[0]
            if wid not in slot_of:
                r = self._emit_window(tup, None, active_wid)
                r.ws_group = ws
                if wid == keep_wid:
                    keep_row = r
                if active_wid and wid == active_wid:
                    active_row = r
        return keep_row, active_row

    def _finish_select(self, keep_row, active_row, select_active):
        self.listbox.show_all()
        # GtkListBox runs the filter at row-insert time, so dividers were
        # tested against a stale _vis_groups (computed for the prior rebuild).
        # Re-filter now that this rebuild's _vis_groups is in place.
        self.listbox.invalidate_filter()
        target = keep_row or (active_row if select_active else None)
        if target is None:
            vis = self.visible_rows()      # first real window row, not a slot gap
            target = vis[0] if vis else None
        if target is not None:
            self.listbox.select_row(target)
            self.scroll_to(target)
        self.update_counter()

    def fkeys_off(self):
        # The fkeys-toggle helper writes 'on'/'off' here; absent means on.
        try:
            with open(os.path.join(RUNTIME, "frofi-fkeys")) as f:
                return f.read().strip() == "off"
        except OSError:
            return False

    def refresh_status(self):
        off = self.fkeys_off()
        ctx = self.status.get_style_context()
        if off:
            ctx.add_class("off")
            self.status.set_text("F-keys off — F1-F12 pass through to apps")
        else:
            ctx.remove_class("off")
            self.status.set_text("F-keys on — F1-F12 jump to slots")

    def toggle_fkeys(self):
        subprocess.run([os.path.expanduser("~/.local/bin/fkeys-toggle")],
                       check=False)
        self.refresh_status()

    def rebuild_windows(self, select_active=False, keep_wid=None):
        self.mode = "window"
        self.prompt.set_text("windows:")
        self.hint.set_markup(HINT_WINDOW)
        self.clear_rows()
        self._prep_rebuild()
        ws = self.current_ws()
        win_rows, all_ids = self.list_windows(ws)
        self._prune_tags(all_ids)
        self.slots = self.refresh_slots(ws, [r[0] for r in win_rows])
        active_wid = self.active_wid_str()
        self._active_geo = None
        keep_row, active_row = self._emit_group(win_rows, self.slots,
                                                keep_wid, active_wid)
        self._finish_select(keep_row, active_row, select_active)

    def _ws_label(self, ws):
        wsobj = self.screen.get_workspace(ws)
        name = wsobj.get_name() if wsobj is not None else None
        return name or f"workspace {ws + 1}"

    def rebuild_ws(self, select_active=False, keep_wid=None):
        # Like windows mode, but stacks every workspace's full 12-slot
        # scaffold top to bottom, each behind a labeled divider.
        self.mode = "ws"
        self.prompt.set_text("workspaces:")
        self.hint.set_markup(HINT_WS)
        self.clear_rows()
        self._prep_rebuild()
        # ws mode lists per-window workspace membership across every group. A
        # cross-workspace move doesn't activate the target here, so without a
        # synchronous refresh Wnck can still report the window's old workspace
        # and the newly-occupied group's divider would stay hidden.
        self.screen.force_update()
        cur = self.current_ws()
        active_wid = self.active_wid_str()
        self._active_geo = None
        keep_row = active_row = None
        all_ids = []
        for ws in range(self.num_ws()):
            self.add_separator(self._ws_label(ws), ws_group=ws)
            win_rows, all_ids = self.list_windows(ws)   # all_ids is ws-agnostic
            slots = self.refresh_slots(ws, [r[0] for r in win_rows])
            if ws == cur:
                self.slots = slots          # F-keys still target the current ws
            kr, ar = self._emit_group(win_rows, slots, keep_wid, active_wid,
                                      placeholders=False, ws=ws)
            keep_row = keep_row or kr
            active_row = active_row or ar
        self._prune_tags(all_ids)
        self._recompute_visible_groups()
        self._finish_select(keep_row, active_row, select_active)

    def rebuild_current(self, **kw):
        # Re-render whichever list mode is active, after an action mutated it.
        if self.mode == "ws":
            self.rebuild_ws(**kw)
        else:
            self.rebuild_windows(**kw)

    def _on_stack_change(self, _screen):
        # Wnck signals can fire while the popup is hidden (background X
        # activity); skip those rebuilds so we don't churn for nothing.
        if self.get_mapped() and self.mode in ("window", "ws"):
            self.rebuild_current(keep_wid=self.selected_wid())

    def wid_ws(self, wid):
        w = self.wnck_window(wid)
        if w is None:
            return self.current_ws()
        wsobj = w.get_workspace()
        return wsobj.get_number() if wsobj is not None else self.current_ws()

    # --- launcher list -------------------------------------------------------
    def rebuild_drun(self):
        self.mode = "drun"
        self.prompt.set_text("drun:")
        self.hint.set_markup(HINT_DRUN)
        self.clear_rows()
        for app in self.apps:
            self.add_row("", "", "", app["icon"], pango(app["name"]),
                         app["name"], desktop_id=app["desktop_id"])
        self.listbox.show_all()
        first = self.listbox.get_row_at_index(0)
        if first is not None:
            self.listbox.select_row(first)
        self.update_counter()

    def refresh_apps(self):
        # Desktop files are parsed once at startup; re-read them so apps
        # installed or removed since then show up without a daemon restart.
        self.icon_map, self.apps = parse_desktop_files()
        self.entry.set_text("")
        self.rebuild_drun()

    # --- help (GNOME custom keybindings) -------------------------------------
    def custom_keybindings(self):
        """Read GNOME's Custom Shortcuts: list of (binding, name, command).

        These are the user's global shortcuts (gnome-control-center's "Custom
        Shortcuts"), the ones usable from anywhere in GNOME while frofi is not
        focused. Read live each time help opens so it tracks the config; the
        relocatable custom-keybinding schema holds name/binding/command per
        entry, listed by path in the media-keys schema.
        """
        base = "org.gnome.settings-daemon.plugins.media-keys"
        try:
            top = Gio.Settings.new(base)
        except Exception:
            return []
        schema = base + ".custom-keybinding"
        out = []
        for path in top.get_strv("custom-keybindings"):
            entry = Gio.Settings.new_with_path(schema, path)
            binding = entry.get_string("binding")
            if binding:
                out.append((binding, entry.get_string("name"),
                            entry.get_string("command")))
        return out

    def rebuild_help(self):
        # A read-only reference listing each global custom shortcut as
        # "<combo>   name". No window/launcher actions apply here, so rows just
        # support type-to-filter; Tab cycles on, Esc closes.
        self.mode = "help"
        self.prompt.set_text("help:")
        self.hint.set_markup(HINT_HELP)
        self.clear_rows()
        entries = self.custom_keybindings()
        # The 12 focus-slot shortcuts (F1-F12) are a repetitive block; sort them
        # to the bottom so the distinct global shortcuts read first. Stable sort
        # keeps each side's config order.
        entries.sort(key=lambda e: "focus-slot" in e[2])
        for binding, name, _cmd in entries:
            combo = prettify_binding(binding)
            markup = f"<b>{pango(combo)}</b>   {pango(name)}"
            self.add_row("", "", "", None, markup, f"{combo} {name}")
        self.listbox.show_all()
        first = self.listbox.get_row_at_index(0)
        if first is not None:
            self.listbox.select_row(first)
        self.update_counter()

    # --- filtering / selection ----------------------------------------------
    def _filter(self, row):
        if self.mode == "tag":
            return True
        if getattr(row, "is_divider", False):
            return row.ws_group in self._vis_groups   # only if group has matches
        return self.entry.get_text().lower() in row.search_text

    def _recompute_visible_groups(self):
        # Workspace groups with at least one window passing the current filter,
        # used to hide dividers for empty or fully-filtered-out groups.
        q = self.entry.get_text().lower()
        self._vis_groups = {r.ws_group for r in self.listbox.get_children()
                            if r.get_selectable() and q in r.search_text
                            and getattr(r, "ws_group", None) is not None}

    def visible_rows(self):
        if self.mode == "tag":
            return []
        q = self.entry.get_text().lower()
        return [r for r in self.listbox.get_children()
                if r.get_selectable() and q in r.search_text]

    def update_counter(self):
        children = [r for r in self.listbox.get_children() if r.get_selectable()]
        total = len(children)
        if self.mode == "tag":
            filtered = total
        else:
            q = self.entry.get_text().lower()
            filtered = sum(1 for r in children if q in r.search_text)
        self.counter.set_text(f"{filtered}/{total}")

    def _sync_placeholder(self):
        self.placeholder.set_visible(
            self.mode != "tag" and self.entry.get_text() == "")

    def on_filter_changed(self, _e):
        self._sync_placeholder()
        if self.mode == "tag":
            return
        self._recompute_visible_groups()
        self.listbox.invalidate_filter()
        vis = self.visible_rows()
        if vis and self.listbox.get_selected_row() not in vis:
            self.listbox.select_row(vis[0])
        self.update_counter()

    def move_selection(self, delta):
        vis = self.visible_rows()
        if not vis:
            return
        cur = self.listbox.get_selected_row()
        idx = vis.index(cur) if cur in vis else 0
        idx = max(0, min(len(vis) - 1, idx + delta))
        self.listbox.select_row(vis[idx])
        self.scroll_to(vis[idx])

    def select_edge(self, last):
        vis = self.visible_rows()
        if not vis:
            return
        row = vis[-1] if last else vis[0]
        self.listbox.select_row(row)
        self.scroll_to(row)

    def fit_height(self):
        # Size the list viewport to exactly VISIBLE_ROWS rows. Row height depends
        # on font, icon and padding, so measure a real row once and cache it.
        if self._row_h is None:
            row = self.listbox.get_row_at_index(0)
            if row is None:
                return
            _min, nat = row.get_preferred_height()
            self._row_h = nat or _min
            if self._row_h <= 0:
                self._row_h = None
                return
        h = self._row_h * VISIBLE_ROWS
        self.scroller.set_min_content_height(h)
        self.scroller.set_max_content_height(h)

    def scroll_to(self, row):
        def _do():
            alloc = row.get_allocation()
            adj = self.scroller.get_vadjustment()
            if adj is None:
                return False
            top, bottom = alloc.y, alloc.y + alloc.height
            if top < adj.get_value():
                adj.set_value(top)
            elif bottom > adj.get_value() + adj.get_page_size():
                adj.set_value(bottom - adj.get_page_size())
            return False
        GLib.idle_add(_do)

    # --- show / hide ---------------------------------------------------------
    def target_monitor(self, display):
        # Monitor of the focused window (matches rofi's default), then the
        # pointer's monitor, then primary. The active window's geometry was
        # cached during rebuild_windows, so this needs no extra subprocess.
        if self._active_geo:
            x, y, w, h = self._active_geo
            m = display.get_monitor_at_point(x + w // 2, y + h // 2)
            if m is not None:
                return m
        pointer = display.get_default_seat().get_pointer()
        if pointer is not None:
            _s, px, py = pointer.get_position()
            m = display.get_monitor_at_point(px, py)
            if m is not None:
                return m
        return display.get_primary_monitor() or display.get_monitor(0)

    def center(self):
        display = Gdk.Display.get_default()
        geo = self.target_monitor(display).get_geometry()
        _min, h = self.get_preferred_height()   # height follows the 12-row viewport
        self.move(geo.x + (geo.width - WIDTH) // 2,
                  geo.y + (geo.height - h) // 2)

    def on_map(self, *_):
        # Super+Tab fires while the compositor still holds a grab on the Super
        # modifier, so the first grab attempt often returns ALREADY_GRABBED (or
        # NOT_VIEWABLE if the window isn't up yet). Without the grab this
        # override-redirect popup gets no keyboard input and can't be
        # dismissed. Retry until it succeeds (typically once the keys release).
        self._grab_tries = 0
        self._grabbed = False
        if self._try_grab():
            GLib.timeout_add(15, self._try_grab)
        return False

    def _try_grab(self):
        if not self.get_mapped():
            return False            # window gone; stop retrying
        win = self.get_window()
        if win is None:
            return False
        seat = win.get_display().get_default_seat()
        status = seat.grab(win, Gdk.SeatCapabilities.KEYBOARD,
                           True, None, None, None)
        if status == Gdk.GrabStatus.SUCCESS:
            self._grabbed = True
            self.entry.grab_focus()
            return False            # got it; stop retrying
        self._grab_tries += 1
        if self._grab_tries >= 80:  # ~1.2s elapsed, give up to avoid spinning
            print(f"frofi: keyboard grab failed ({status.value_nick}); "
                  "hiding", file=sys.stderr, flush=True)
            self.hide_switcher()    # don't leave an unusable popup on screen
            return False
        return True                 # keep retrying on the timeout

    def show_switcher(self, origin=None):
        # Idempotent: the F13 grab thread can briefly re-fire during the gap
        # between its XUngrabKeyboard and the popup's seat.grab landing.
        if self.get_mapped():
            return
        recv = time.time()         # realtime, comparable to the wrapper's t0
        m0 = time.monotonic()
        self.entry.set_text("")
        self.rebuild_windows(select_active=True)
        self.refresh_status()
        self.fit_height()          # lock the viewport to 12 rows before centering
        self.center()
        self.show_all()
        self._sync_placeholder()   # show_all forces it visible; correct it
        if DEBUG:
            render = (time.monotonic() - m0) * 1000
            if origin is not None:
                ipc = (recv - origin) * 1000   # wrapper t0 -> daemon handling
                print(f"frofi: e2e {ipc + render:.1f} ms "
                      f"(ipc {ipc:.1f} + render {render:.1f})",
                      file=sys.stderr, flush=True)
            else:
                print(f"frofi: render {render:.1f} ms",
                      file=sys.stderr, flush=True)

    def hide_switcher(self):
        win = self.get_window()
        if win is not None:
            win.get_display().get_default_seat().ungrab()
        self.mode = "window"
        self.tag_target = None
        self.hide()

    def schedule(self, ms, fn):
        GLib.timeout_add(ms, lambda: (fn(), False)[1])

    # --- actions -------------------------------------------------------------
    def selected_wid(self):
        row = self.listbox.get_selected_row()
        return getattr(row, "wid", None) if row else None

    def _parent_xid_of(self, wid):
        """X11 parent xid that "owns" the row's wid -- the host wezterm
        for tm:, the host chrome for cr:, the X11 window itself for hex
        wids. Used by ops that need to operate on the parent."""
        if not wid:
            return None
        if is_tmux_wid(wid):
            host = self._wezterm_hosts().for_session(tmux_session_name(wid))
            return host.xid if host is not None else None
        if is_chrome_wid(wid):
            tab = self._chrome_registry().tab(chrome_target_id(wid))
            return tab.parent_xid if tab is not None else None
        try:
            return int(wid, 16)
        except ValueError:
            return None

    def _sibling_group_of(self, wid):
        """Group key for the "these belong together" sibling-highlight.
        Chrome tabs are grouped per-window (host xid). Tmux sessions are
        grouped per-workspace-pool: each session lives in its own host,
        but visually the user thinks of all ws<N>- sessions as the same
        bucket. Regular X11 rows have no siblings."""
        if not wid:
            return None
        if is_tmux_wid(wid):
            ws = self._ws_of_session(tmux_session_name(wid))
            return f"tm:ws{ws}" if ws is not None else None
        if is_chrome_wid(wid):
            tab = self._chrome_registry().tab(chrome_target_id(wid))
            return f"cr:{tab.parent_xid}" if tab is not None else None
        return None

    def _on_row_selected(self, _box, row):
        # The selected row already has its own :selected styling. Every
        # other row sharing its sibling group gets the .sibling class.
        group = None
        if row is not None:
            wid = getattr(row, "wid", None)
            group = self._sibling_group_of(wid) if wid else None
        for r in self.listbox.get_children():
            ctx = r.get_style_context()
            if (group is not None and r is not row
                    and getattr(r, "wid", None)
                    and self._sibling_group_of(r.wid) == group):
                ctx.add_class("sibling")
            else:
                ctx.remove_class("sibling")

    def _ws_of_session(self, name):
        m = TMUX_SESSION_RE.match(name)
        return int(m.group(1)) if m else None

    def _invalidate_tmux_caches(self):
        """Clear the 100ms caches that mirror tmux/wezterm state so the
        next registry build reads it fresh. Call after any tmux action
        (kill, rename, switch-client, detach-client) that changes which
        session is attached to which tty."""
        self._panes_cache = None
        self._tmux_cache = None
        self._tmux_clients_cache = None

    def _sibling_session_on_ws(self, exclude_name, ws):
        """Pick any other tmux session in the same `ws<N>-` pool as the
        excluded one. Used by close/move/detach handlers to retarget a
        client before its session disappears so the host wezterm doesn't
        exit out from under the user."""
        return next(
            (s["name"] for s in self._tmux_sessions()
             if s["name"] != exclude_name
             and self._ws_of_session(s["name"]) == ws),
            None)

    def _activate_wid(self, wid, t=None):
        """Bring `wid` to focus. For a virtual window (tmux session) whose
        workspace still has a host wezterm, retarget that client via
        `tmux switch-client -c <tty>`. For an orphan (host closed), spawn a
        fresh wezterm attached to the session so the user recovers it.
        """
        if t is None:
            t = self.server_time()
        if is_tmux_wid(wid):
            name = tmux_session_name(wid)
            registry = self._wezterm_hosts()
            # Refuse to mirror: if the session is already attached, raise
            # that wezterm rather than retargeting another host (would
            # silently move the user) or spawning a new one (would add a
            # mirror).
            host = registry.for_session(name)
            if host is not None:
                self.activate_wnck(host.wnck_window, t)
                return
            # Session is detached. If this workspace still has a host
            # wezterm, retarget it; otherwise spawn a fresh one.
            ws = self._ws_of_session(name)
            ws_host = next(iter(registry.on_workspace(ws)), None) \
                if ws is not None else None
            if ws_host is not None:
                self._tmux("switch-client", "-c", ws_host.tty, "-t", name)
                self.activate_wnck(ws_host.wnck_window, t)
            else:
                # Orphan session: no host wezterm on its workspace. Spawn
                # one running `tmux attach`; it inherits the current X11
                # workspace from where this is launched (frofi or IPC).
                try:
                    subprocess.Popen(
                        ["wezterm", "start", "--",
                         "tmux", "attach", "-t", name],
                        cwd=os.path.expanduser("~"),
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        start_new_session=True)
                except OSError:
                    pass
            return
        if is_chrome_wid(wid):
            tab = self._chrome_registry().tab(chrome_target_id(wid))
            if tab is None:
                return
            self._chrome_call({"action": "activate", "tabId": int(tab.target_id)})
            host = self.wnck_window(wid)
            if host is not None:
                self.activate_wnck(host, t)
            return
        w = self.wnck_window(wid)
        if w is not None:
            self.activate_wnck(w, t)

    def on_activate(self):
        if self.mode == "drun":
            row = self.listbox.get_selected_row()
            self.hide_switcher()
            if row is not None:
                self.launch_app(row.desktop_id)
            return
        wid = self.selected_wid()
        t = self.server_time()
        self.hide_switcher()
        if wid:
            self._activate_wid(wid, t)

    def focus_selected(self):
        # Activate the window but keep the switcher up, so the user can preview
        # or cycle without dismissing. Activating moves input focus to the
        # window and can break our seat grab, so raise the popup back above it
        # and re-assert the keyboard grab once the activation has settled.
        wid = self.selected_wid()
        if not wid:
            return
        self._activate_wid(wid)
        # Switching a tmux session or chrome tab leaves the host X11 window's
        # stacking unchanged, so window-stacking-changed never fires and the
        # active-row badge would stay stale. Force a rebuild once the backend
        # has settled and the new attached-session / active-tab title has
        # landed.
        if is_tmux_wid(wid):
            self._invalidate_tmux_caches()
            self.schedule(80, lambda: self.rebuild_current(keep_wid=wid))
        elif is_chrome_wid(wid):
            self._chrome_cache = None
            self.schedule(80, lambda: self.rebuild_current(keep_wid=wid))

        def reassert():
            win = self.get_window()
            if win is not None and self.get_mapped():
                win.raise_()
                self._grab_tries = 0
                if self._try_grab():
                    GLib.timeout_add(15, self._try_grab)
        self.schedule(60, reassert)

    def launch_app(self, desktop_id):
        # Detach from the daemon's stdio and process group so the launched
        # app survives a daemon restart and isn't killed by a broken pipe
        # on the daemon's stderr.
        argv = (["gtk-launch", desktop_id]
                if GLib.find_program_in_path("gtk-launch")
                else ["gio", "launch", os.path.join(DESKTOP_DIRS[0], desktop_id)])
        subprocess.Popen(argv,
                         stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL,
                         start_new_session=True)

    def jump_slot(self, n):
        if 1 <= n <= 12 and self.slots[n - 1]:
            wid = self.slots[n - 1]
            t = self.server_time()
            self.hide_switcher()
            self._activate_wid(wid, t)

    def close_selected(self):
        row = self.listbox.get_selected_row()
        wid = getattr(row, "wid", None) if row else None
        if not wid:
            return
        # Keep the selection at the same position so repeated Delete walks
        # down the list, rather than jumping back to the active/first row.
        vis = self.visible_rows()
        idx = vis.index(row) if row in vis else 0
        if is_tmux_wid(wid):
            name = tmux_session_name(wid)
            # If the killed session is currently attached, the wezterm
            # client exits with tmux and takes the host window down. Try
            # to switch its client to another session on the same
            # workspace first; only if no fallback exists do we accept
            # the wezterm going down.
            host = self._wezterm_hosts().for_session(name)
            if host is not None:
                fallback = self._sibling_session_on_ws(name, host.workspace)
                if fallback is not None:
                    self._tmux("switch-client", "-c", host.tty,
                               "-t", fallback)
            self._tmux("kill-session", "-t", name)
            self._invalidate_tmux_caches()
        elif is_chrome_wid(wid):
            tab = self._chrome_registry().tab(chrome_target_id(wid))
            if tab is not None:
                self._chrome_call({"action": "close", "tabId": int(tab.target_id)})
            self._chrome_cache = None
        else:
            w = self.wnck_window(wid)
            if w is not None:
                w.close(self.server_time())

        def after():
            self.rebuild_current()
            vis2 = self.visible_rows()
            if vis2:
                target = vis2[min(idx, len(vis2) - 1)]
                self.listbox.select_row(target)
                self.scroll_to(target)
        self.schedule(90, after)

    def move_to_ws(self, delta):
        wid = self.selected_wid()
        if not wid:
            return
        if is_tmux_wid(wid):
            self._move_tmux_session(wid, delta)
            return
        if is_chrome_wid(wid):
            self._move_chrome_tab(wid, delta)
            return
        # In ws mode the selected window may be on any workspace, so move it
        # relative to its own; in windows mode it is on the current one.
        base = self.wid_ws(wid) if self.mode == "ws" else self.current_ws()
        target = base + delta   # clamp, no wraparound
        if target < 0 or target >= self.num_ws():
            return
        w = self.wnck_window(wid)
        wsobj = self.screen.get_workspace(target)
        if w is not None and wsobj is not None:
            w.move_to_workspace(wsobj)
            if self.mode != "ws":
                wsobj.activate(self.server_time())   # follow the window across
        if self.mode == "ws":
            self.schedule(90, lambda: self.rebuild_ws(keep_wid=wid))
        else:
            self.schedule(90, lambda: self.rebuild_windows(select_active=True))

    def _move_tmux_session(self, wid, delta):
        """Move a tmux session row to another workspace by renaming the
        session (ws<N>-... -> ws<M>-...). The renamed session is then
        attached on the destination so the user lands on its content;
        the source wezterm (if it was the one attached) gets switched to
        another same-workspace session first, or detached so it exits
        cleanly if there is no fallback. When a new wezterm is spawned
        on the destination, its geometry mirrors the source wezterm."""
        name = tmux_session_name(wid)
        m = TMUX_SESSION_RE.match(name)
        if not m:
            return
        base = int(m.group(1))
        target = base + delta                       # clamp, no wraparound
        if target < 0 or target >= self.num_ws():
            return
        new_name = f"ws{target}-{name[m.end():]}"

        # Capture the source wezterm's geometry before any detach so we
        # can mirror it on the destination if a fresh wezterm spawns.
        registry = self._wezterm_hosts()
        src_host = registry.for_session(name)
        src_geo = src_host.wnck_window.get_geometry() if src_host else None
        if src_host is not None:
            fallback = self._sibling_session_on_ws(name, base)
            if fallback is not None:
                self._tmux("switch-client", "-c", src_host.tty,
                           "-t", fallback)
            else:
                # No same-workspace fallback: detach the source client
                # so the source wezterm exits, instead of carrying the
                # moved session across as a cross-workspace stray.
                self._tmux("detach-client", "-t", src_host.tty)
        self._tmux("rename-session", "-t", name, new_name)
        self._invalidate_tmux_caches()
        # Activate target workspace first so the user follows the move
        # and any spawned wezterm lands on the right X11 workspace.
        if self.mode != "ws":
            wsobj = self.screen.get_workspace(target)
            if wsobj is not None:
                wsobj.activate(self.server_time())
        # Snapshot wezterm xids before activating so a freshly-spawned
        # wezterm can be identified by exclusion.
        pre_xids = self._x11_xids_with_class(WEZTERM_INST)
        dst_host = next(iter(self._wezterm_hosts().on_workspace(target)), None)
        new_wid = TMUX_WID_PREFIX + new_name
        self._activate_wid(new_wid)
        if src_geo is not None and dst_host is None:
            # _activate_wid spawned a fresh wezterm; snap it to the source
            # geometry once it shows up.
            gx, gy, gw, gh = src_geo
            self._wait_for_new_window(
                pre_xids, WEZTERM_INST,
                lambda w: self._move_resize(w, gx, gy, gw, gh))
        self.schedule(90, lambda: self.rebuild_current(keep_wid=new_wid))

    def _move_chrome_tab(self, wid, delta):
        """Move a chrome tab to another workspace's chrome host. If the
        target workspace has a chrome window, reparent via
        chrome.tabs.move; otherwise detach the tab into a new window via
        chrome.windows.create and wmctrl-move that window to the target.
        """
        registry = self._chrome_registry()
        tab = registry.tab(chrome_target_id(wid))
        if tab is None:
            return
        target = tab.workspace + delta              # clamp, no wraparound
        if target < 0 or target >= self.num_ws():
            return
        # If the target workspace already has a chrome host, reparent
        # the tab into it; the registry already resolved its CDP id.
        dest = next(iter(registry.windows_on_workspace(target)), None)
        payload = {"action": "move_tab", "tabId": int(tab.target_id)}
        if dest is not None:
            payload["windowId"] = dest.cdp_id
        self._chrome_call(payload)
        self._chrome_cache = None
        # When we detached into a new window, snap that new X11 window to
        # the target workspace. Identify it as a chrome window we hadn't
        # seen before; the existing-xid set comes from the pre-move
        # snapshot.
        if dest is None:
            pre_xids = self._x11_xids_with_class(CHROME_INST)
            wsobj = self.screen.get_workspace(target)
            if wsobj is not None:
                self._wait_for_new_window(
                    pre_xids, CHROME_INST,
                    lambda new_win: new_win.move_to_workspace(wsobj))
        if self.mode != "ws":
            wsobj = self.screen.get_workspace(target)
            if wsobj is not None:
                wsobj.activate(self.server_time())
        self.schedule(180, lambda: self.rebuild_current(keep_wid=wid))

    def _detach_selected(self):
        """Move the selected virtual-window row into a new X11 window of
        its own, then half-tile source and new window side-by-side on the
        same monitor."""
        wid = self.selected_wid()
        if not wid:
            return
        if is_tmux_wid(wid):
            self._detach_tmux_session(wid)
        elif is_chrome_wid(wid):
            self._detach_chrome_tab(wid)

    def _match_src_geometry(self, src, dst):
        """Move/resize dst so it covers the same pixels as src. The user
        moves whichever window they want from there; detach itself just
        ensures the new window is a faithful clone of the source's
        geometry so it's reachable and sized usefully."""
        if dst is None or src is None:
            return
        if src.get_xid() not in {w.get_xid()
                                 for w in self.screen.get_windows()}:
            return
        gx, gy, gw, gh = src.get_geometry()
        dst.unmaximize()
        self._move_resize(dst, gx, gy, gw, gh)

    def _x11_xids_with_class(self, inst_prefix):
        """xids of currently-visible X11 windows whose WM_CLASS instance
        starts with inst_prefix. Snapshotted before an action that may
        spawn a new window so `_wait_for_new_window` can spot the new
        one by exclusion."""
        return {w.get_xid() for w in self.screen.get_windows()
                if (w.get_class_instance_name() or "")
                .lower().startswith(inst_prefix)}

    def _wait_for_new_window(self, pre_xids, inst_filter, on_found,
                             attempts=15):
        """Poll Wnck until a window whose class-instance starts with
        inst_filter and whose xid is not in pre_xids appears; call
        on_found(window) with it. Used by detach handlers that depend on
        Chrome/wezterm finishing their startup."""
        def settle(attempt=0):
            self.screen.force_update()
            for w in self.screen.get_windows():
                if w.get_xid() in pre_xids:
                    continue
                if not (w.get_class_instance_name() or "") \
                        .lower().startswith(inst_filter):
                    continue
                on_found(w)
                return False
            if attempt < attempts:
                self.schedule(100, lambda: settle(attempt + 1))
            return False
        self.schedule(120, settle)

    def _detach_tmux_session(self, wid):
        name = tmux_session_name(wid)
        base = self._ws_of_session(name)
        if base is None:
            return
        # Detach only makes sense when the source has somewhere to switch
        # to. Without a fallback, "detach" would just spawn another mirror
        # of the same session, which is what dug us into the four-mirror
        # state earlier; refuse instead.
        fallback = self._sibling_session_on_ws(name, base)
        if fallback is None:
            return
        # Capture the wezterm attached to this session (if any) so the
        # detached copy can mirror its geometry; switch it to the
        # fallback so the source pane doesn't die under the user.
        src_host = self._wezterm_hosts().for_session(name)
        src_window = src_host.wnck_window if src_host else None
        if src_host is not None:
            self._tmux("switch-client", "-c", src_host.tty,
                       "-t", fallback)
        pre_xids = self._x11_xids_with_class(WEZTERM_INST)
        self.hide_switcher()
        try:
            subprocess.Popen(
                ["wezterm", "start", "--",
                 "tmux", "attach", "-t", name],
                cwd=os.path.expanduser("~"),
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True)
        except OSError:
            return
        self._wait_for_new_window(
            pre_xids, WEZTERM_INST,
            lambda new_win: self._match_src_geometry(src_window, new_win))

    def _detach_chrome_tab(self, wid):
        # Detach only makes sense when the source window has other tabs
        # to keep showing. Detaching the only tab in a window would just
        # move that tab to a new window and close the source -- same
        # number of windows, no side-by-side gain.
        registry = self._chrome_registry()
        tab = registry.tab(chrome_target_id(wid))
        if tab is None:
            return
        parent = registry.window_for_cdp(tab.parent_cdp_id)
        if parent is None or len(parent.tabs) <= 1:
            return
        src_window = parent.wnck_window
        pre_xids = self._x11_xids_with_class(CHROME_INST)
        self.hide_switcher()
        # windowId omitted -> chrome.windows.create({tabId}) detaches.
        self._chrome_call({"action": "move_tab", "tabId": int(tab.target_id)})
        self._chrome_cache = None
        self._wait_for_new_window(
            pre_xids, CHROME_INST,
            lambda new_win: self._match_src_geometry(src_window, new_win))

    def _reattach_selected(self):
        """Inverse of detach: take a lone tab/session out of its solo host
        and merge it into the workspace's most-populated peer host. No-op
        when there is no other host to merge into."""
        wid = self.selected_wid()
        if not wid:
            return
        if is_tmux_wid(wid):
            self._reattach_tmux_session(wid)
        elif is_chrome_wid(wid):
            self._reattach_chrome_tab(wid)

    def _reattach_chrome_tab(self, wid):
        registry = self._chrome_registry()
        tab = registry.tab(chrome_target_id(wid))
        if tab is None:
            return
        parent = registry.window_for_cdp(tab.parent_cdp_id)
        if parent is None or len(parent.tabs) != 1:
            return  # source isn't a lone-tab window; nothing to reattach
        peers = [w for w in registry.windows_on_workspace(self.current_ws())
                 if w.cdp_id != parent.cdp_id]
        if not peers:
            return
        dest = max(peers, key=lambda w: len(w.tabs))
        self._chrome_call({"action": "move_tab",
                           "tabId": int(tab.target_id),
                           "windowId": dest.cdp_id})
        self._chrome_cache = None
        self.hide_switcher()

    def _reattach_tmux_session(self, wid):
        name = tmux_session_name(wid)
        ws = self._ws_of_session(name)
        if ws is None:
            return
        ws_prefix = f"ws{ws}-"
        ws_hosts = [h for h in self._wezterm_hosts().on_workspace(ws)
                    if h.session.startswith(ws_prefix)]
        if len(ws_hosts) < 2:
            return
        # Lone check: exactly one host attached to this session. If the
        # session is mirrored across multiple wezterms (common after
        # repeated detaches without a fallback), bail rather than pick
        # one mirror to detach and leave the rest hanging.
        hosts_for_name = [h for h in ws_hosts if h.session == name]
        if len(hosts_for_name) != 1:
            return
        src = hosts_for_name[0]
        dest = next((h for h in ws_hosts if h is not src), None)
        if dest is None:
            return
        # Switch destination host to this session, then drop the source
        # client so its wezterm exits. Destination's previous session
        # remains in the pool (detached) and reachable via frofi.
        self._tmux("switch-client", "-c", dest.tty, "-t", name)
        self._tmux("detach-client", "-t", src.tty)
        self._invalidate_tmux_caches()
        self.hide_switcher()

    def switch_ws(self, delta):
        target = self.current_ws() + delta   # clamp, no wraparound
        if target < 0 or target >= self.num_ws():
            return
        wsobj = self.screen.get_workspace(target)
        if wsobj is not None:
            wsobj.activate(self.server_time())
        # The launcher list is workspace-independent, so only refresh the
        # window list (and stay in drun mode if that's where we are).
        if self.mode == "window":
            self.schedule(90, lambda: self.rebuild_windows(select_active=True))

    # --- window layout (mirrors GNOME's Super+arrow tiling) ------------------
    def _monitor_at(self, x, y):
        disp = Gdk.Display.get_default()
        for i in range(disp.get_n_monitors()):
            g = disp.get_monitor(i).get_geometry()
            if g.x <= x < g.x + g.width and g.y <= y < g.y + g.height:
                return i, disp.get_monitor(i)
        return 0, disp.get_monitor(0)

    def _move_resize(self, w, x, y, width, height):
        mask = (Wnck.WindowMoveResizeMask.X | Wnck.WindowMoveResizeMask.Y
                | Wnck.WindowMoveResizeMask.WIDTH | Wnck.WindowMoveResizeMask.HEIGHT)
        w.set_geometry(Wnck.WindowGravity.STATIC, mask, x, y, width, height)

    def _tile(self, w, area, side):
        # GNOME's half-tile is a vertically-maximized, half-width window pinned
        # to one side. Reproduce it: clear maximize, place the half, re-max vert.
        half = area.width // 2
        x = area.x if side == "left" else area.x + half
        w.unmaximize()
        self._move_resize(w, x, area.y, half, area.height)
        w.maximize_vertically()

    def set_window_mode(self, mode):
        wid = self.selected_wid()
        if not wid:
            return
        w = self.wnck_window(wid)
        if w is None:
            return
        # Fullscreen windows have _NET_WM_ALLOWED_ACTIONS without MAXIMIZE/MOVE/
        # RESIZE, so mutter ignores tile/max/float ClientMessages until fullscreen
        # is cleared. Clear it first; the subsequent action then takes effect.
        if w.is_fullscreen():
            w.set_fullscreen(False)
        gx, gy, gw, gh = w.get_geometry()
        if mode == "max":
            w.unmaximize()
            w.maximize()
        elif mode == "window":
            w.unmaximize()
        else:                                   # "left" / "right"
            _i, mon = self._monitor_at(gx + gw // 2, gy + gh // 2)
            self._tile(w, mon.get_workarea(), mode)
        self.schedule(90, lambda: self.rebuild_current(keep_wid=wid))

    def move_to_monitor(self, delta):
        wid = self.selected_wid()
        if not wid:
            return
        w = self.wnck_window(wid)
        if w is None:
            return
        disp = Gdk.Display.get_default()
        n = disp.get_n_monitors()
        gx, gy, gw, gh = w.get_geometry()
        cur, cmon = self._monitor_at(gx + gw // 2, gy + gh // 2)
        target = cur + delta                    # clamp, no wraparound
        if target < 0 or target >= n:
            return
        cgeo = cmon.get_geometry()
        darea = disp.get_monitor(target).get_workarea()
        vmax, hmax = w.is_maximized_vertically(), w.is_maximized_horizontally()
        if vmax and hmax:                        # keep maximized on the new mon
            w.unmaximize()
            self._move_resize(w, darea.x, darea.y, darea.width, darea.height)
            w.maximize()
        elif vmax and not hmax:                  # keep the same half on new mon
            side = "left" if gx + gw // 2 < cgeo.x + cgeo.width // 2 else "right"
            self._tile(w, darea, side)
        else:                                    # floating: same relative offset
            nx = darea.x + (gx - cgeo.x)
            ny = darea.y + (gy - cgeo.y)
            nx = max(darea.x, min(nx, darea.x + darea.width - gw))
            ny = max(darea.y, min(ny, darea.y + darea.height - gh))
            self._move_resize(w, nx, ny, gw, gh)
        self.schedule(90, lambda: self.rebuild_current(keep_wid=wid))

    def reorder(self, delta):
        wid = self.selected_wid()
        if not wid:
            return
        ws = self.wid_ws(wid) if self.mode == "ws" else self.current_ws()
        slots = self.slots_for(ws)
        if wid not in slots:
            return
        src = slots.index(wid)
        dst = src + delta
        if 0 <= dst <= 11:
            slots[src], slots[dst] = slots[dst], slots[src]
            self._mark_dirty()
            self.rebuild_current(keep_wid=wid)

    # --- inline tag editing --------------------------------------------------
    def begin_tag(self):
        wid = self.selected_wid()
        if not wid:
            return
        self._tag_return = self.mode    # window or ws; restored on commit/cancel
        self.tag_target = wid
        self.mode = "tag"
        self.prompt.set_text("tag:")
        self.hint.set_markup(HINT_TAG)
        self.entry.set_text(self.tags.get(wid, ""))
        self.entry.grab_focus()

    def commit_tag(self):
        tag = self.entry.get_text().strip()
        if tag:
            self.tags[self.tag_target] = tag
        else:
            self.tags.pop(self.tag_target, None)
        self._mark_dirty()
        wid = self.tag_target
        self.tag_target = None
        self.entry.set_text("")
        self.mode = getattr(self, "_tag_return", "window")
        self.rebuild_current(keep_wid=wid)

    def cancel_tag(self):
        self.tag_target = None
        self.entry.set_text("")
        self.mode = getattr(self, "_tag_return", "window")
        self.rebuild_current()

    # --- key handling --------------------------------------------------------
    def on_key(self, _w, event):
        key = event.keyval
        mods = event.state & (Gdk.ModifierType.CONTROL_MASK
                              | Gdk.ModifierType.MOD1_MASK
                              | Gdk.ModifierType.SHIFT_MASK
                              | Gdk.ModifierType.SUPER_MASK
                              | Gdk.ModifierType.MOD4_MASK)
        ctrl = bool(mods & Gdk.ModifierType.CONTROL_MASK)
        alt = bool(mods & Gdk.ModifierType.MOD1_MASK)
        shift = bool(mods & Gdk.ModifierType.SHIFT_MASK)
        # Right Super (still in mod4) reports through event.state. For left
        # Super (remapped to F13), query the X server directly: auto-repeat
        # interleaves fake KeyRelease events that would defeat any release-
        # based state machine.
        sup = (bool(mods & (Gdk.ModifierType.SUPER_MASK
                            | Gdk.ModifierType.MOD4_MASK))
               or keycode_held(self._xdpy, LEFT_SUPER_KEYCODE))

        if self.mode == "tag":
            if key == Gdk.KEY_Escape:
                self.cancel_tag()
                return True
            if key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
                self.commit_tag()
                return True
            return False

        if key == Gdk.KEY_Escape:
            self.hide_switcher()
            return True
        if key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            if ctrl and self.mode in ("window", "ws"):
                self.focus_selected()       # activate but keep the switcher up
            else:
                self.on_activate()
            return True
        if key == Gdk.KEY_Up and not alt and not sup and not shift:
            self.move_selection(-1)
            return True
        if key == Gdk.KEY_Down and not alt and not sup and not shift:
            self.move_selection(1)
            return True
        if key == Gdk.KEY_Page_Up and not alt and not sup and not shift:
            self.move_selection(-(VISIBLE_ROWS - 1))
            return True
        if key == Gdk.KEY_Page_Down and not alt and not sup and not shift:
            self.move_selection(VISIBLE_ROWS - 1)
            return True
        if key == Gdk.KEY_Home and not alt and not sup and not shift:
            self.select_edge(False)
            return True
        if key == Gdk.KEY_End and not alt and not sup and not shift:
            self.select_edge(True)
            return True
        if key in (Gdk.KEY_Tab, Gdk.KEY_ISO_Left_Tab):
            # Cycle window -> workspaces -> drun -> help; Shift+Tab back.
            self.entry.set_text("")
            order = ["window", "ws", "drun", "help"]
            i = order.index(self.mode) if self.mode in order else 0
            back = key == Gdk.KEY_ISO_Left_Tab or shift
            nxt = order[(i + (-1 if back else 1)) % len(order)]
            if nxt == "drun":
                self.rebuild_drun()
            elif nxt == "ws":
                self.rebuild_ws(select_active=True)
            elif nxt == "help":
                self.rebuild_help()
            else:
                self.rebuild_windows(select_active=True)
            return True
        # Workspace switching works in both window and drun mode; the popup
        # grabs the keyboard, so the global binding can't reach it here.
        if ctrl and alt and key == Gdk.KEY_Left:
            self.switch_ws(-1)
            return True
        if ctrl and alt and key == Gdk.KEY_Right:
            self.switch_ws(1)
            return True
        # XF86Launch5-7 mirror the global switch-to-workspace-1/2/3 bindings.
        if Gdk.KEY_Launch5 <= key <= Gdk.KEY_Launch7:
            self.switch_ws(key - Gdk.KEY_Launch5 - self.current_ws())
            return True
        if ctrl and not shift and not alt and not sup and key in (Gdk.KEY_f,
                                                                  Gdk.KEY_F):
            self.toggle_fkeys()
            return True

        if self.mode in ("window", "ws"):
            if key == Gdk.KEY_Delete:
                self.close_selected()
                return True
            if alt and not ctrl and key == Gdk.KEY_Left:
                self.move_to_ws(-1)
                return True
            if alt and not ctrl and key == Gdk.KEY_Right:
                self.move_to_ws(1)
                return True
            if alt and key == Gdk.KEY_Up:
                self.reorder(-1)
                return True
            if alt and key == Gdk.KEY_Down:
                self.reorder(1)
                return True
            if ctrl and key in (Gdk.KEY_t, Gdk.KEY_T):
                self.begin_tag()
                return True
            if sup and not ctrl and not alt and not shift:
                if key == Gdk.KEY_Left:
                    self.move_to_monitor(-1)
                    return True
                if key == Gdk.KEY_Right:
                    self.move_to_monitor(1)
                    return True
                if key == Gdk.KEY_Up:
                    self.set_window_mode("max")
                    return True
                if key == Gdk.KEY_Down:
                    self.set_window_mode("window")
                    return True
                if key in (Gdk.KEY_d, Gdk.KEY_D):
                    self._detach_selected()
                    return True
                if key in (Gdk.KEY_r, Gdk.KEY_R):
                    self._reattach_selected()
                    return True
                if key in (Gdk.KEY_q, Gdk.KEY_Q):
                    self.hide_switcher()
                    subprocess.Popen(
                        [os.path.expanduser("~/.local/bin/wezterm-spawn")],
                        cwd=os.path.expanduser("~"),
                        stdin=subprocess.DEVNULL,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        start_new_session=True)
                    return True
                if key in (Gdk.KEY_w, Gdk.KEY_W):
                    self.hide_switcher()
                    subprocess.Popen(
                        [os.path.expanduser("~/.local/bin/chrome-spawn")],
                        cwd=os.path.expanduser("~"),
                        stdin=subprocess.DEVNULL,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        start_new_session=True)
                    return True
                if key in (Gdk.KEY_e, Gdk.KEY_E):
                    self.hide_switcher()
                    subprocess.Popen(
                        [os.path.expanduser("~/.local/bin/code-spawn")],
                        cwd=os.path.expanduser("~"),
                        stdin=subprocess.DEVNULL,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        start_new_session=True)
                    return True
            if not ctrl and not alt and not sup and not shift:
                if key == Gdk.KEY_Left:
                    self.set_window_mode("left")
                    return True
                if key == Gdk.KEY_Right:
                    self.set_window_mode("right")
                    return True
            if Gdk.KEY_F1 <= key <= Gdk.KEY_F12:
                self.jump_slot(key - Gdk.KEY_F1 + 1)
                return True

        if self.mode == "drun":
            if ctrl and key in (Gdk.KEY_r, Gdk.KEY_R):
                self.refresh_apps()
                return True

        return False  # printable keys fall through to the filter entry


# --- IPC ---------------------------------------------------------------------
def run_daemon():
    win = Switcher()

    def dispatch(cmd):
        parts = cmd.split()
        if not parts:
            return
        if parts[0] == "show":
            origin = None
            if len(parts) > 1:
                try:
                    origin = float(parts[1])
                except ValueError:
                    pass
            win.show_switcher(origin)
        elif parts[0] == "focus-slot" and len(parts) == 2:
            ws = win.current_ws()
            _rows, _all = win.list_windows(ws)
            slots = win.refresh_slots(ws, [r[0] for r in _rows])
            try:
                n = int(parts[1])
            except ValueError:
                return
            if 1 <= n <= 12 and slots[n - 1]:
                win._activate_wid(slots[n - 1])
        elif parts[0] == "switch-ws" and len(parts) == 2:
            try:
                delta = int(parts[1])
            except ValueError:
                return
            target = win.current_ws() + delta   # clamp, no wraparound
            if target < 0 or target >= win.num_ws():
                return
            wsobj = win.screen.get_workspace(target)
            if wsobj is not None:
                wsobj.activate(win.server_time())

    def on_incoming(_service, conn, _src):
        try:
            # Commands are short single lines (e.g. "focus-slot 3"); one read of
            # 256 bytes covers them. The wrapper never pipelines requests.
            data = conn.get_input_stream().read_bytes(256, None).get_data()
            GLib.idle_add(lambda: (dispatch(data.decode().strip()), False)[1])
        except Exception:
            pass
        finally:
            conn.close()
        return False

    # Guard against a second daemon: hold an exclusive lock for our lifetime.
    # The wrapper's "send first, then start" ordering already makes this rare,
    # but the lock closes the race where two daemons start at once and the
    # second unlinks the first's live socket. flock releases automatically on
    # exit, so a crashed daemon leaves no stale lock.
    lock_fd = os.open(LOCK_PATH, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("frofi-daemon already running; exiting", file=sys.stderr, flush=True)
        sys.exit(0)

    if os.path.exists(SOCK_PATH):
        os.unlink(SOCK_PATH)
    service = Gio.SocketService.new()
    service.add_address(Gio.UnixSocketAddress.new(SOCK_PATH),
                        Gio.SocketType.STREAM, Gio.SocketProtocol.DEFAULT, None)
    # The socket drives window actions; restrict it to the owning user even
    # when it falls back to a world-traversable /tmp (XDG_RUNTIME_DIR unset).
    os.chmod(SOCK_PATH, 0o600)
    service.connect("incoming", on_incoming)
    service.start()

    def shutdown():
        win._flush_state()
        try:
            os.unlink(SOCK_PATH)
        except OSError:
            pass
        Gtk.main_quit()
        return False

    # SIGUSR1 kept as a fallback "show" trigger.
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1,
                         lambda: (win.show_switcher(), True)[1])
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, shutdown)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, shutdown)

    # Own the launch grab ourselves instead of routing through a GNOME custom
    # shortcut. Mutter's keybinding flow holds an active keyboard grab until
    # the trigger key releases, which blocks the popup's own seat grab; with
    # XGrabKey in GrabModeAsync the keyboard stays free, so a hold-then-arrow
    # chord lands on the first press.
    def trigger_show():
        win.show_switcher()
        return False
    if not wait_for_super_remap(win._xdpy):
        print("frofi-daemon: super-remap did not complete in time; "
              "F13 grab may misbehave until it runs", file=sys.stderr,
              flush=True)
    threading.Thread(target=f13_grab_loop, args=(trigger_show,),
                     daemon=True, name="frofi-f13-grab").start()

    print(f"frofi-daemon ready (pid {os.getpid()})", file=sys.stderr, flush=True)
    Gtk.main()


if __name__ == "__main__":
    run_daemon()   # --client is handled above, before the gi import
