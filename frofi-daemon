@dataclass(frozen=True)
class WeztermHost:
    """A wezterm X11 window that's currently hosting a tmux client.

    Internally the registry identifies each host by (gui_pid,
    mux_window_id) -- the only pair that's unique system-wide -- but
    those are kept inside `WeztermHostRegistry.build` so callers see
    only the resolved fields below.
    """
    wnck_window: object          # Wnck.Window (the X11 surface)
    xid: int
    tty: str                     # /dev/pts/N of the host pane
    session: str                 # tmux session currently attached on `tty`
    workspace: int               # X11 workspace number


class WeztermHostRegistry:
    """Per-rebuild snapshot of every wezterm window that's currently
    hosting a tmux client. Single source of truth for every caller in
    the daemon that needs to cross the wezterm <-> tmux boundary.

    Built fresh per `_wezterm_hosts()` call (microseconds; the underlying
    panes/tmux data is 100ms-cached); callers ask for hosts by xid,
    session, or workspace. Identity plumbing (pid + mux window_id +
    title prefix + per-gui sockets) lives in `build` so future schema
    changes touch only this class.
    """

    def __init__(self, hosts):
        self._hosts = list(hosts)
        self._by_xid = {h.xid: h for h in self._hosts}
        # for_session picks the first host matching `name` (any will do
        # for "raise to this session"); hosts_for_session returns all
        # of them, used by callers that care about mirror count.
        self._by_session = {}
        for h in self._hosts:
            self._by_session.setdefault(h.session, h)

    @classmethod
    def build(cls, screen, tmux_clients, panes):
        """Inputs:
            screen        wnck screen.
            tmux_clients  {tty -> session_name} from `tmux list-clients`.
            panes         pane dicts from `wezterm cli list` aggregated
                          across every wezterm-gui socket, each tagged
                          with `gui_pid`.
        """
        tty_by_key = {}
        for p in panes:
            key = (p.get("gui_pid"), p.get("window_id"))
            if key[0] is None or key[1] is None:
                continue
            tty = p.get("tty_name")
            if not tty:
                continue
            if p.get("is_active") or key not in tty_by_key:
                tty_by_key[key] = tty
        hosts = []
        for w in screen.get_windows():
            if (w.get_class_instance_name() or "").lower() != WEZTERM_INST:
                continue
            wsobj = w.get_workspace()
            if wsobj is None:
                continue
            pid = w.get_pid()
            if not pid:
                continue
            m = WEZTERM_TITLE_PREFIX_RE.match(w.get_name() or "")
            if not m:
                continue
            mux_wid = int(m.group(1))
            tty = tty_by_key.get((pid, mux_wid))
            if tty is None:
                continue
            sess = tmux_clients.get(tty)
            if sess is None:
                continue
            hosts.append(WeztermHost(
                wnck_window=w, xid=w.get_xid(),
                tty=tty, session=sess,
                workspace=wsobj.get_number()))
        return cls(hosts)

    def on_workspace(self, ws):
        return [h for h in self._hosts if h.workspace == ws]

    def for_session(self, name):
        return self._by_session.get(name)

    def hosts_for_session(self, name):
        return [h for h in self._hosts if h.session == name]

    def for_xid(self, xid):
        return self._by_xid.get(xid)


def is_tmux_wid(wid):
    return isinstance(wid, str) and wid.startswith(TMUX_WID_PREFIX)


def tmux_session_name(wid):
    return wid[len(TMUX_WID_PREFIX):]


# Chrome tabs become first-class rows the same way tmux sessions do. A
# Chrome extension reports tab/window state to a native messaging host
# (~/.local/bin/chrome-frofi-host), which serves snapshots and accepts
# activate/close commands over a unix socket the daemon connects to.
# This avoids Chrome's "default profile disallows --remote-debugging-port"
# restriction.
CHROME_WID_PREFIX = "cr:"
CHROME_INST = "google-chrome"
CHROME_HOST_SOCK = os.path.join(RUNTIME, "frofi-chrome.sock")
# Chrome appends this to the X11 _NET_WM_NAME; stripped to recover the
# active tab title for X11 <-> chrome-window matching.
CHROME_TITLE_SUFFIX = " - Google Chrome"


def is_chrome_wid(wid):
    return isinstance(wid, str) and wid.startswith(CHROME_WID_PREFIX)


def chrome_target_id(wid):
    return wid[len(CHROME_WID_PREFIX):]


@dataclass(frozen=True)
class ChromeTab:
    """A single Chrome tab, materialized from the native host's snapshot.

    `target_id` is the CDP tabId stringified -- that's what action
    payloads ({"action":"move_tab","tabId":...}) and frofi wids
    ("cr:<target_id>") both speak. `parent_xid` / `parent_cdp_id`
    point at the chrome window hosting this tab, already resolved by
    the registry's X11<->CDP matcher.
    """
    target_id: str
    title: str
    url: str
    active: bool
    parent_xid: int
    parent_cdp_id: int
    workspace: int


@dataclass(frozen=True)
class ChromeWindow:
    """A Chrome X11 window with its resolved CDP windowId and tabs.

    The (xid, cdp_id) pair is resolved by ChromeRegistry via the
    persistent pin map first, then geometry, then active-tab title,
    then arbitrary -- callers never see the resolution itself.
    """
    wnck_window: object          # Wnck.Window
    xid: int
    cdp_id: int
    workspace: int
    tabs: tuple                  # tuple of ChromeTab


class ChromeRegistry:
    """X11 chrome window <-> CDP windowId resolver.

    Long-lived on the daemon: owns the persistent pin map of
    focus-confirmed (X11 xid, CDP id) pairs and a refreshed snapshot
    of resolved windows + tabs. Callers ask by xid, cdp_id, tab
    target_id, or workspace; the identity scheme (pin-first, then
    geometry, then title, then arbitrary) is confined to `rebuild`.

    A pinned (x11, cdp) pair survives across rebuilds and gets evicted
    only when the CDP window disappears or another xid claims its CDP
    via focus. Without focus pinning, two maximized chromes on
    different workspaces would share geometry and the per-workspace
    tab lists would smear.
    """

    def __init__(self):
        self._pin = {}                  # xid -> cdp_id, persistent
        self._windows_by_xid = {}
        self._windows_by_cdp = {}
        self._tabs = {}                 # target_id -> ChromeTab

    def rebuild(self, screen, snapshot, active_xid):
        """Refresh from a CDP snapshot. Mutates the pin map: evicts
        stale pins for non-live CDP ids; repins the (active X11, focused
        CDP) pair when chrome reports a focused window and that xid is
        a live chrome window."""
        tabs_in = snapshot.get("tabs") or []
        wins_in = snapshot.get("windows") or []
        cdp_bounds = {}
        for w in wins_in:
            wid = w.get("id")
            if (wid is None
                    or "left" not in w or "top" not in w
                    or "width" not in w or "height" not in w):
                continue
            cdp_bounds[wid] = (w["left"], w["top"], w["width"], w["height"])
        # Evict stale pins.
        live_cdp = set(cdp_bounds.keys())
        for xid in [k for k, v in self._pin.items() if v not in live_cdp]:
            del self._pin[xid]
        # Repin (active X11, focused CDP) when both agree it's a chrome
        # window. Two maximized chromes on different workspaces share
        # their X11 geometry; only focus anchoring keeps the tab lists
        # correctly partitioned by workspace.
        focused_cdp = next((w["id"] for w in wins_in
                            if w.get("focused")), None)
        if focused_cdp is not None and active_xid is not None:
            for w in screen.get_windows():
                if w.get_xid() != active_xid:
                    continue
                if (w.get_class_instance_name() or "") \
                        .lower().startswith(CHROME_INST):
                    for old in [k for k, v in self._pin.items()
                                if v == focused_cdp and k != active_xid]:
                        del self._pin[old]
                    self._pin[active_xid] = focused_cdp
                break
        # Collect chrome X11 windows.
        chrome_x11 = []
        for w in screen.get_windows():
            if w.is_skip_tasklist():
                continue
            if not (w.get_class_instance_name() or "") \
                    .lower().startswith(CHROME_INST):
                continue
            if w.is_minimized():
                continue
            chrome_x11.append(w)
        # Group tabs by CDP windowId for the title-match fallback and
        # for tab enumeration below.
        cdp_by_window = {}
        for t in tabs_in:
            winid = t.get("windowId")
            if winid is None:
                continue
            cdp_by_window.setdefault(winid, []).append(t)
        # Resolve each X11 chrome window to a CDP windowId. used_cdp
        # is global across the resolution sweep so two X11 windows
        # never claim the same CDP.
        used_cdp = set()
        resolved = []
        for x11w in chrome_x11:
            xid = x11w.get_xid()
            wsobj = x11w.get_workspace()
            if wsobj is None:
                continue
            cdp_id = self._resolve_cdp(x11w, xid, cdp_bounds,
                                       cdp_by_window, used_cdp)
            if cdp_id is None:
                continue
            used_cdp.add(cdp_id)
            resolved.append((x11w, xid, wsobj.get_number(), cdp_id))
        # Materialize windows + tabs.
        self._windows_by_xid = {}
        self._windows_by_cdp = {}
        self._tabs = {}
        for x11w, xid, ws_num, cdp_id in resolved:
            active_title = self._active_tab_title(x11w)
            tabs = []
            for t in cdp_by_window.get(cdp_id, []):
                tid = t.get("id")
                if tid is None:
                    continue
                tabs.append(ChromeTab(
                    target_id=str(tid),
                    title=t.get("title") or "",
                    url=t.get("url") or "",
                    active=(t.get("title") == active_title),
                    parent_xid=xid,
                    parent_cdp_id=cdp_id,
                    workspace=ws_num))
            cw = ChromeWindow(
                wnck_window=x11w, xid=xid, cdp_id=cdp_id,
                workspace=ws_num, tabs=tuple(tabs))
            self._windows_by_xid[xid] = cw
            self._windows_by_cdp[cdp_id] = cw
            for tab in tabs:
                self._tabs[tab.target_id] = tab

    @staticmethod
    def _active_tab_title(x11w):
        """Strip the " - Google Chrome" suffix from a chrome X11 window's
        _NET_WM_NAME to recover the active tab's title. The result is
        used both as a tie-break in X11<->CDP resolution and as the
        "which tab is visible" check when emitting tab rows."""
        x11_title = x11w.get_name() or ""
        if x11_title.endswith(CHROME_TITLE_SUFFIX):
            return x11_title[:-len(CHROME_TITLE_SUFFIX)]
        return x11_title

    def _resolve_cdp(self, x11w, xid, cdp_bounds, cdp_by_window, used_cdp):
        """X11 chrome window -> CDP windowId via pin, geometry, title,
        or arbitrary, in that order. Returns None when nothing matches
        (no live CDP windows left)."""
        # Priority 1: focus-pinned, if still live and unclaimed.
        pinned = self._pin.get(xid)
        if pinned is not None and pinned in cdp_bounds and pinned not in used_cdp:
            return pinned
        # Priority 2: geometry within 50 px. Two maximized chromes on
        # the same monitor share coordinates so this only disambiguates
        # when sizes/positions actually differ.
        gx, gy, _gw, _gh = x11w.get_geometry()
        best_cdp = None
        best_d = 50
        for cdp_id, (cl, ct, _cw, _ch) in cdp_bounds.items():
            if cdp_id in used_cdp:
                continue
            d = abs(cl - gx) + abs(ct - gy)
            if d <= best_d:
                best_d = d
                best_cdp = cdp_id
        if best_cdp is not None:
            return best_cdp
        # Priority 3: active-tab-title match.
        active_title = self._active_tab_title(x11w)
        for cdp_id, tlist in cdp_by_window.items():
            if cdp_id in used_cdp:
                continue
            if any(t.get("title") == active_title for t in tlist):
                return cdp_id
        # Priority 4: take any remaining CDP. The user will fix it the
        # next time they focus this window -- focus events repin.
        for cdp_id in cdp_bounds:
            if cdp_id not in used_cdp:
                return cdp_id
        return None

    def windows_on_workspace(self, ws):
        return [w for w in self._windows_by_xid.values()
                if w.workspace == ws]

    def window_for_xid(self, xid):
        return self._windows_by_xid.get(xid)

    def window_for_cdp(self, cdp_id):
        return self._windows_by_cdp.get(cdp_id)

    def tab(self, target_id):
        return self._tabs.get(target_id)


def pango(s):
    return GLib.markup_escape_text(s)


# Modifier and key aliases for rendering a GNOME accelerator string (e.g.
# "<Primary><Alt>l") as a readable combo ("Ctrl+Alt+L"). <Primary> is GNOME's
# portable alias for Control; Mod4 is Super.
_MOD_NAMES = {"Primary": "Ctrl", "Control": "Ctrl", "Ctrl": "Ctrl",
              "Alt": "Alt", "Shift": "Shift", "Super": "Super", "Mod4": "Super"}
_KEY_NAMES = {"space": "Space", "Page_Up": "Page Up", "Page_Down": "Page Down",
              "Prior": "Page Up", "Next": "Page Down", "Return": "Enter"}


def prettify_binding(binding):
    mods = [_MOD_NAMES.get(t, t) for t in re.findall(r"<([^>]+)>", binding)]
    key = re.sub(r"<[^>]+>", "", binding)
    key = _KEY_NAMES.get(key, key)
    if len(key) == 1:                       # single letters like 'l', 'b'
        key = key.upper()
    return "+".join(mods + [key]) if key else "+".join(mods)


# --- desktop file parsing ----------------------------------------------------
def parse_desktop_files():
    """Return (icon_map, apps).

    icon_map: lower(StartupWMClass) -> Icon, for matching live windows.
    apps: list of dicts {name, icon, desktop_id} for the launcher (drun).
    """
    icon_map = {}
    apps = []
    seen = set()
    for d in DESKTOP_DIRS:
        for path in sorted(glob.glob(os.path.join(d, "*.desktop"))):
            desktop_id = os.path.basename(path)
            if desktop_id in seen:
                continue
            section = None
            vals = {}
            try:
                with open(path, encoding="utf-8", errors="replace") as fh:
                    for line in fh:
                        line = line.rstrip("\n")
                        if line.startswith("["):
                            section = line[1:-1] if line.endswith("]") else line[1:]
                        elif section == "Desktop Entry" and "=" in line:
                            k, v = line.split("=", 1)
                            if k not in vals:
                                vals[k] = v
            except OSError:
                continue
            seen.add(desktop_id)
            wmclass, icon = vals.get("StartupWMClass"), vals.get("Icon")
            if wmclass and icon:
                icon_map[wmclass.lower()] = icon
            if (vals.get("Type") == "Application"
                    and vals.get("NoDisplay", "false").lower() != "true"
                    and vals.get("Name") and vals.get("Exec")):
                apps.append({"name": vals["Name"], "icon": icon or "",
                             "desktop_id": desktop_id})
    apps.sort(key=lambda a: a["name"].lower())
    return icon_map, apps


