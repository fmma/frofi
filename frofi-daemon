        self.placeholder.set_valign(Gtk.Align.CENTER)
        overlay.add_overlay(self.placeholder)
        overlay.set_overlay_pass_through(self.placeholder, True)
        inputbar.pack_start(overlay, True, True, 0)
        self.counter = Gtk.Label(xalign=1.0)
        self.counter.get_style_context().add_class("counter")
        inputbar.pack_start(self.counter, False, False, 0)
