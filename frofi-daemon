#!/usr/bin/env python3
"""frofi: a resident window switcher daemon for X11 / EWMH.

A single long-running process owns all state (slots, tags, the icon/app maps)
and renders an override-redirect GTK popup on demand. Override-redirect means
mutter neither manages nor animates the window, so it appears instantly; an
explicit keyboard grab gives it focus. Clients talk to it over a Unix socket:

    frofi-daemon                 run the daemon
    frofi-daemon --client show   show the switcher
    frofi-daemon --client focus-slot N   jump to slot N (no UI)

Set FROFI_DEBUG=1 to log show latency to stderr.

Features:
  - Per-workspace list, active window preselected, type-to-filter.
  - Stable F1-F12 slots, per workspace, held in memory for the daemon's
    lifetime (holes on close, lowest-empty reclaim).
  - Tags in ~/.cache/frofi-tags, shown as [tag], dead entries pruned.
  - Delete close; Alt+Left/Right move window to prev/next workspace;
    Ctrl+Alt+Left/Right switch workspace; Alt+Up/Down reorder slot;
    Ctrl+T inline tag edit; F1-F12 jump to slot; Enter activate; Esc dismiss.
  - Tab toggles a drun-style app launcher.
"""
import glob
import os
import signal
import socket
import subprocess
import sys
import time

OWN_TITLE = "frofi-daemon-window"
WIDTH, HEIGHT = 660, 460
ICON_SIZE = 18
CACHE = os.path.expanduser("~/.cache")
TAGS_FILE = os.path.join(CACHE, "frofi-tags")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
SOCK_PATH = os.path.join(RUNTIME, "frofi.sock")
DEBUG = bool(os.environ.get("FROFI_DEBUG"))

DESKTOP_DIRS = [
    "/usr/share/applications",
    "/usr/local/share/applications",
    os.path.expanduser("~/.local/share/applications"),
    "/var/lib/snapd/desktop/applications",
    "/var/lib/flatpak/exports/share/applications",
]

CSS = b"""
