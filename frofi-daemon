        self._icon_cache = {}
        self._mode_icons = {}
        self.mode = "window"
        self.slot_map = {}          # ws -> 12-element slot list (in-memory)
        self.slots = [""] * 12      # current workspace's slots (view of above)
        self.tags = {}              # wid -> tag, persisted across daemon restarts
        self._state_save_timer = None
        self._load_state()
        self.tag_target = None      # wid being tagged in tag mode
        # Long-lived resolver for chrome X11 <-> CDP windowId. Owns the
