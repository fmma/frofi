        # injects fake KeyRelease events that would clear the state spuriously.
        self._xdpy = _xlib.XOpenDisplay(None)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.set_name("frame")               # carries the 1px window frame border
        inputbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
