#!/bin/bash
# Client for the resident frofi-daemon. With no arguments, shows the
# switcher; otherwise forwards the command (e.g. `frofi focus-slot 3`).
# Starts the daemon if it is not already running, then retries.
#
# The send runs on every Super+Tab, so it avoids spawning a Python interpreter:
# socat writes the one-line command straight to the daemon's Unix socket
# (~5 ms). Falls back to the daemon's own --client mode if socat is absent.
dir="$(dirname "$0")"
sock="${XDG_RUNTIME_DIR:-/tmp}/frofi.sock"
[ "$#" -eq 0 ] && set -- show

# With FROFI_DEBUG set, attach a wall-clock origin to `show` so the daemon can
# log end-to-end latency. Skipped otherwise to avoid the extra fork.
[ "$1" = "show" ] && [ -n "${FROFI_DEBUG:-}" ] && set -- show "$(date +%s.%N)"

send() {
    if command -v socat >/dev/null 2>&1; then
        printf '%s\n' "$*" | socat -t0 - "UNIX-CONNECT:$sock" 2>/dev/null
    else
        "$dir/frofi-daemon" --client "$@"
    fi
}

if send "$@"; then
    exit 0
fi

setsid -f "$dir/frofi-daemon" >/dev/null 2>&1
for _ in $(seq 1 100); do
    send "$@" && exit 0
    sleep 0.02
done
exit 1
